:- module version_array2d.
:- use_module builtin.
:- use_module exception.
:- use_module int.
:- use_module list.
:- use_module private_builtin.
:- use_module require.
:- use_module string.
:- use_module uint.
:- use_module version_array.
:- use_module string.format.
:- use_module string.parse_util.

:- type version_array2d(T)
    --->    version_array2d(
                 int,
                 int,
                 version_array.version_array(T)
            ).

version_array2d.bounds(version_array2d.version_array2d(V_4, V_5, V_6), V_4, V_5).

version_array2d.copy(V_3) = V_4 :-
    V_3 = version_array2d.version_array2d(V_5, V_6, V_7) : version_array2d.version_array2d(T_1),
    V_4 = version_array2d.version_array2d(V_5, V_6, V_8) : version_array2d.version_array2d(T_1),
    V_8 = version_array.copy(V_7).

version_array2d.elem(V_5, V_6, V_7) = V_8 :-
    version_array2d.lookup(V_7, V_5, V_6, V_8).

version_array2d.'elem :='(V_6, V_7, V_10, V_9) = V_11 :-
    version_array2d.set(V_6, V_7, V_9, V_10, V_11).

version_array2d.in_ubounds(version_array2d.version_array2d(V_4, V_5, V_6), V_7, V_8) :-
    V_9 = uint.cast_to_int(V_7),
    V_10 = uint.cast_to_int(V_8),
    int.(V_9 < V_4),
    int.(V_10 < V_5).

version_array2d.ubounds(version_array2d.version_array2d(V_4, V_5, V_6), V_7, V_8) :-
    V_7 = uint.cast_from_int(V_4),
    V_8 = uint.cast_from_int(V_5).

version_array2d.uelem(V_5, V_6, V_7) = V_8 :-
    version_array2d.ulookup(V_7, V_5, V_6, V_8).

version_array2d.'uelem :='(V_6, V_7, V_10, V_9) = V_11 :-
    version_array2d.uset(V_6, V_7, V_9, V_10, V_11).

version_array2d.uinit(V_5, V_6, V_7) = V_8 :-
    V_9 = uint.cast_to_int(V_5),
    V_10 = uint.cast_to_int(V_6),
    V_8 = version_array2d.init(V_9, V_10, V_7).

version_array2d.unsafe_rewind(version_array2d.version_array2d(V_3, V_4, V_5)) = version_array2d.version_array2d(V_3, V_4, V_6) :-
    V_6 = version_array.unsafe_rewind(V_5).

version_array2d.uresize(V_6, V_7, V_8, V_9) = V_10 :-
    V_10 = version_array2d.resize(V_6, V_11, V_12, V_9),
    V_11 = uint.cast_to_int(V_7),
    V_12 = uint.cast_to_int(V_8).

:- pragma termination_info(version_array2d.bounds(builtin.in, builtin.out, builtin.out), finite(-3, [no, yes, no, no]), cannot_loop).
:- pragma termination_info(version_array2d.copy(builtin.in) = builtin.out, infinite, can_loop).
:- pragma termination_info(version_array2d.elem(builtin.in, builtin.in, builtin.in) = builtin.out, infinite, can_loop).
:- pragma termination_info(version_array2d.'elem :='(builtin.in, builtin.in, builtin.in, builtin.in) = builtin.out, infinite, can_loop).
:- pragma termination_info(version_array2d.in_bounds(builtin.in, builtin.in, builtin.in), finite(0, [no, no, no, no]), cannot_loop).
:- pragma termination_info(version_array2d.in_ubounds(builtin.in, builtin.in, builtin.in), finite(0, [no, no, no, no]), can_loop).
:- pragma termination_info(version_array2d.init(builtin.in, builtin.in, builtin.in) = builtin.out, infinite, can_loop).
:- pragma termination_info(version_array2d.lists(builtin.in) = builtin.out, infinite, can_loop).
:- pragma termination_info(version_array2d.lookup(builtin.in, builtin.in, builtin.in, builtin.out), infinite, can_loop).
:- pragma termination_info(version_array2d.resize(builtin.in, builtin.in, builtin.in, builtin.in) = builtin.out, infinite, can_loop).
:- pragma termination_info(version_array2d.set(builtin.in, builtin.in, builtin.in, builtin.in, builtin.out), infinite, can_loop).
:- pragma termination_info(version_array2d.ubounds(builtin.in, builtin.out, builtin.out), infinite, can_loop).
:- pragma termination_info(version_array2d.uelem(builtin.in, builtin.in, builtin.in) = builtin.out, infinite, can_loop).
:- pragma termination_info(version_array2d.'uelem :='(builtin.in, builtin.in, builtin.in, builtin.in) = builtin.out, infinite, can_loop).
:- pragma termination_info(version_array2d.uinit(builtin.in, builtin.in, builtin.in) = builtin.out, infinite, can_loop).
:- pragma termination_info(version_array2d.ulookup(builtin.in, builtin.in, builtin.in, builtin.out), infinite, can_loop).
:- pragma termination_info(version_array2d.unsafe_rewind(builtin.in) = builtin.out, infinite, can_loop).
:- pragma termination_info(version_array2d.uresize(builtin.in, builtin.in, builtin.in, builtin.in) = builtin.out, infinite, can_loop).
:- pragma termination_info(version_array2d.uset(builtin.in, builtin.in, builtin.in, builtin.in, builtin.out), infinite, can_loop).
:- pragma termination_info(version_array2d.version_array2d(builtin.in) = builtin.out, infinite, can_loop).

:- pragma exceptions(predicate, version_array2d.bounds, 3, 0, will_not_throw).
:- pragma exceptions(function, version_array2d.copy, 1, 0, may_throw(user_exception)).
:- pragma exceptions(function, version_array2d.elem, 3, 0, may_throw(user_exception)).
:- pragma exceptions(function, version_array2d.'elem :=', 4, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, version_array2d.in_bounds, 3, 0, will_not_throw).
:- pragma exceptions(predicate, version_array2d.in_ubounds, 3, 0, may_throw(user_exception)).
:- pragma exceptions(function, version_array2d.init, 3, 0, may_throw(user_exception)).
:- pragma exceptions(function, version_array2d.lists, 1, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, version_array2d.lookup, 4, 0, may_throw(user_exception)).
:- pragma exceptions(function, version_array2d.resize, 4, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, version_array2d.set, 5, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, version_array2d.ubounds, 3, 0, may_throw(user_exception)).
:- pragma exceptions(function, version_array2d.uelem, 3, 0, may_throw(user_exception)).
:- pragma exceptions(function, version_array2d.'uelem :=', 4, 0, may_throw(user_exception)).
:- pragma exceptions(function, version_array2d.uinit, 3, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, version_array2d.ulookup, 4, 0, may_throw(user_exception)).
:- pragma exceptions(function, version_array2d.unsafe_rewind, 1, 0, may_throw(user_exception)).
:- pragma exceptions(function, version_array2d.uresize, 4, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, version_array2d.uset, 5, 0, may_throw(user_exception)).
:- pragma exceptions(function, version_array2d.version_array2d, 1, 0, may_throw(user_exception)).
