:- pragma exceptions(predicate, bitmap.unsafe_is_clear, 2, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, bitmap.unsafe_is_set, 2, 0, may_throw(user_exception)).
:- pragma exceptions(function, bitmap.unsafe_set, 2, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, bitmap.unsafe_set, 3, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, bitmap.unsafe_set_bit, 4, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, bitmap.unsafe_set_bits, 5, 0, will_not_throw).
:- pragma exceptions(predicate, bitmap.unsafe_set_byte, 4, 0, will_not_throw).
:- pragma exceptions(predicate, bitmap.unsafe_set_uint8, 4, 0, will_not_throw).
:- pragma exceptions(predicate, bitmap.write_bitmap, 3, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, bitmap.write_bitmap, 4, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, bitmap.write_bitmap_range, 5, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, bitmap.write_bitmap_range, 6, 0, may_throw(user_exception)).
:- pragma exceptions(function, bitmap.xor, 2, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, bitmap.zip, 4, 0, may_throw(user_exception)).
:- pragma exceptions(predicate, bitmap.zip_loop, 5, 0, may_throw(user_exception)).
