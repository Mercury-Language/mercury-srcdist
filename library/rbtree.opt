:- module rbtree.
:- use_module assoc_list.
:- use_module bool.
:- use_module builtin.
:- use_module list.
:- use_module maybe.
:- use_module pair.
:- use_module private_builtin.
:- use_module require.
:- use_module uint.

:- type rbtree(K, V)
    --->    empty 
    ;       red(
                 K,
                 V,
                 rbtree.rbtree(K, V),
                 rbtree.rbtree(K, V)
            )
    ;       black(
                 K,
                 V,
                 rbtree.rbtree(K, V),
                 rbtree.rbtree(K, V)
            ).

