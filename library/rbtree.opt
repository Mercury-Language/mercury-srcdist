      V_7 = rbtree.empty : rbtree.rbtree(K_2, V_1),
      fail
    ;
      V_7 = rbtree.red(V_9, V_10, V_11, V_12) : rbtree.rbtree(K_2, V_1),
      builtin.compare(V_13, V_6, V_9),
      ( % disjunction
        V_13 = builtin.(=) : builtin.comparison_result,
        call(V_5, V_10, V_14),
        V_8 = rbtree.red(V_9, V_14, V_11, V_12) : rbtree.rbtree(K_2, V_1)
      ;
        V_13 = builtin.(<) : builtin.comparison_result,
        rbtree.transform_value(V_5, V_6, V_11, V_15),
        V_8 = rbtree.red(V_9, V_10, V_15, V_12) : rbtree.rbtree(K_2, V_1)
      ;
        V_13 = builtin.(>) : builtin.comparison_result,
        rbtree.transform_value(V_5, V_6, V_12, V_16),
        V_8 = rbtree.red(V_9, V_10, V_11, V_16) : rbtree.rbtree(K_2, V_1)
      )
    ;
      V_7 = rbtree.black(V_23, V_24, V_25, V_26) : rbtree.rbtree(K_2, V_1),
      builtin.compare(V_27, V_6, V_23),
