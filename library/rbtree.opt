        V_27 = builtin.(=) : builtin.comparison_result,
        call(V_5, V_24, V_17),
        V_8 = rbtree.black(V_23, V_17, V_25, V_26) : rbtree.rbtree(K_2, V_1)
      ;
        V_27 = builtin.(<) : builtin.comparison_result,
        rbtree.transform_value(V_5, V_6, V_25, V_18),
        V_8 = rbtree.black(V_23, V_24, V_18, V_26) : rbtree.rbtree(K_2, V_1)
      ;
        V_27 = builtin.(>) : builtin.comparison_result,
        rbtree.transform_value(V_5, V_6, V_26, V_19),
        V_8 = rbtree.black(V_23, V_24, V_25, V_19) : rbtree.rbtree(K_2, V_1)
