:- module mdbcomp.read_trace_counts.
:- interface.
:- use_module io.
:- use_module list.
:- use_module maybe.
:- use_module set.
:- use_module mdbcomp.trace_counts.
:- type read_trace_counts_file_result
    --->    rtcf_ok(
                 mdbcomp.trace_counts.trace_count_file_type,
                 mdbcomp.trace_counts.trace_counts
            )
    ;       rtcf_error_message(
                 string
            ).
:- pred read_and_union_trace_counts(maybe.maybe(io.text_output_stream), list.list(string), int, set.set(mdbcomp.trace_counts.trace_count_file_type), mdbcomp.trace_counts.trace_counts, maybe.maybe(string), io.io, io.io).
:- mode read_and_union_trace_counts(builtin.in, builtin.in, builtin.out, builtin.out, builtin.out, builtin.out, builtin.di, builtin.uo) is det.
:- pred read_trace_counts_file(string, mdbcomp.read_trace_counts.read_trace_counts_file_result, io.io, io.io).
:- mode read_trace_counts_file(builtin.in, builtin.out, builtin.di, builtin.uo) is det.
