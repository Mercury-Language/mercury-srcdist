				fi; \
			done; \
			rm -f $(deps_subdir)$*.dep $(deps_subdir)$*.dv \
				*.$A *.$(EXT_FOR_SHARED_LIB) \
				*.jar *.dll *.err *.dep_err; \
		fi; \
