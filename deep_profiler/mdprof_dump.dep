	for file in x $$grade_files; do \
		if test "$$file" != x; then \
			mv -f $$file tmp_dir > /dev/null 2>&1; \
			true; \
		fi; \
	done && \
	{ mv -f $(deps_subdir)$*.dep $(deps_subdir)$*.dv \
		*.$A *.$(EXT_FOR_SHARED_LIB) tmp_dir || \
		true; } && \
	for grade in $(ALL_LIBGRADES); do \
