                 hlds.hlds_goal.hlds_goal,
                 hlds.make_hlds.state_var.svar_state
            ).
:- type new_statevar_map.
:- type svar == parse_tree.prog_data.prog_var.
:- type svar_inner_atomic_scope_info.
:- type svar_outer_atomic_scope_info.
:- type svar_state.
:- type svar_store.
:- implementation.
:- use_module one_or_more_map.
:- type maybe_statevar_arg_pos.
:- type new_statevar_map == one_or_more_map.one_or_more_map(parse_tree.prog_data.prog_var, hlds.make_hlds.state_var.maybe_statevar_arg_pos).
:- type readonly_context_kind
    --->    roc_lambda .
