:- module make.prereqs_cache.
:- interface.
:- type module_prereqs_result.
:- type module_to_module_set_cache.
:- type module_to_target_id_set_cache.
:- type prereqs_result(T).
:- type process_modules_where
	where	type_is_abstract_enum(1).
:- type target_id_prereqs_result.
:- type trans_prereqs_cache.
:- type trans_prereqs_key.
:- type transitive_dependencies_type
	where	type_is_abstract_enum(2).
:- type_representation(module_prereqs_result, is_eqv_to(make.prereqs_cache.prereqs_result(module_index))).
:- type_representation(module_to_module_set_cache, is_eqv_to(map(module_index, make.prereqs_cache.module_prereqs_result))).
:- type_representation(module_to_target_id_set_cache, is_eqv_to(map(module_index, make.prereqs_cache.target_id_prereqs_result))).
:- type_representation(process_modules_where, du_repn(enum("process_only_modules_in_cur_dir", "process_modules_anywhere", [],  no_c_j_cs))).
:- type_representation(target_id_prereqs_result, is_eqv_to(make.prereqs_cache.prereqs_result(target_id_index))).
:- type_representation(trans_prereqs_cache, is_eqv_to(map(make.prereqs_cache.trans_prereqs_key, make.prereqs_cache.module_prereqs_result))).
:- type_representation(trans_prereqs_key, is_word_aligned_ptr).
:- type_representation(transitive_dependencies_type, du_repn(enum("interface_imports", "all_imports", ["all_dependencies"],  no_c_j_cs))).
