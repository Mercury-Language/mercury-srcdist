:- module make.prereqs_cache.
:- interface.
:- use_module io.
:- use_module libs.
:- use_module map.
:- use_module libs.maybe_util.
:- use_module make.index_set.
:- use_module make.make_info.
:- type dependency_file_deps_result == make.prereqs_cache.deps_result(make.index_set.dependency_file_index).
:- type deps_result(T)
    --->    deps_result(
                 (make.prereqs_cache).dr_success :: libs.maybe_util.maybe_succeeded,
                 (make.prereqs_cache).dr_set :: make.index_set.index_set(T)
            ).
:- type module_deps_result == make.prereqs_cache.deps_result(make.index_set.module_index).
:- type module_to_dep_file_set_cache == map.map(make.index_set.module_index, make.prereqs_cache.dependency_file_deps_result).
:- type module_to_module_set_cache == map.map(make.index_set.module_index, make.prereqs_cache.module_deps_result).
:- type process_modules_where
    --->    process_only_modules_in_cur_dir 
    ;       process_modules_anywhere .
:- type trans_prereqs_cache == map.map(make.prereqs_cache.trans_prereqs_key, make.prereqs_cache.module_deps_result).
:- type trans_prereqs_key
    --->    trans_prereqs_key(
                 make.index_set.module_index,
                 make.prereqs_cache.transitive_dependencies_type,
                 make.prereqs_cache.process_modules_where
            ).
:- type transitive_dependencies_type
    --->    interface_imports 
    ;       all_imports 
    ;       all_dependencies .
:- pred add_to_anc0_dir1_indir2_intermod_cache(make.index_set.module_index, make.prereqs_cache.dependency_file_deps_result, make.make_info.make_info, make.make_info.make_info).
:- mode add_to_anc0_dir1_indir2_intermod_cache(builtin.in, builtin.in, builtin.in, builtin.out) is det.
:- pred add_to_direct_imports_intermod_cache(make.index_set.module_index, make.prereqs_cache.module_deps_result, make.make_info.make_info, make.make_info.make_info).
:- mode add_to_direct_imports_intermod_cache(builtin.in, builtin.in, builtin.in, builtin.out) is det.
:- pred add_to_direct_imports_non_intermod_cache(make.index_set.module_index, make.prereqs_cache.module_deps_result, make.make_info.make_info, make.make_info.make_info).
:- mode add_to_direct_imports_non_intermod_cache(builtin.in, builtin.in, builtin.in, builtin.out) is det.
:- pred add_to_foreign_imports_non_intermod_trans_cache(make.index_set.module_index, make.prereqs_cache.module_deps_result, make.make_info.make_info, make.make_info.make_info).
:- mode add_to_foreign_imports_non_intermod_trans_cache(builtin.in, builtin.in, builtin.in, builtin.out) is det.
:- pred add_to_indirect_imports_intermod_cache(make.index_set.module_index, make.prereqs_cache.module_deps_result, make.make_info.make_info, make.make_info.make_info).
:- mode add_to_indirect_imports_intermod_cache(builtin.in, builtin.in, builtin.in, builtin.out) is det.
:- pred add_to_trans_prereqs_cache(make.prereqs_cache.trans_prereqs_key, make.prereqs_cache.module_deps_result, make.make_info.make_info, make.make_info.make_info).
:- mode add_to_trans_prereqs_cache(builtin.in, builtin.in, builtin.in, builtin.out) is det.
:- func init_module_to_dep_file_set_cache = make.prereqs_cache.module_to_dep_file_set_cache.
:- func init_module_to_module_set_cache = make.prereqs_cache.module_to_module_set_cache.
:- func init_trans_prereqs_cache = make.prereqs_cache.trans_prereqs_cache.
:- pred record_make_prereqs_cache_stats(io.io, io.io).
:- mode record_make_prereqs_cache_stats(builtin.di, builtin.uo) is det.
:- pred search_anc0_dir1_indir2_intermod_cache(make.make_info.make_info, make.index_set.module_index, make.prereqs_cache.dependency_file_deps_result).
:- mode search_anc0_dir1_indir2_intermod_cache(builtin.in, builtin.in, builtin.out) is semidet.
:- pred search_direct_imports_intermod_cache(make.make_info.make_info, make.index_set.module_index, make.prereqs_cache.module_deps_result).
:- mode search_direct_imports_intermod_cache(builtin.in, builtin.in, builtin.out) is semidet.
:- pred search_direct_imports_non_intermod_cache(make.make_info.make_info, make.index_set.module_index, make.prereqs_cache.module_deps_result).
:- mode search_direct_imports_non_intermod_cache(builtin.in, builtin.in, builtin.out) is semidet.
:- pred search_foreign_imports_non_intermod_trans_cache(make.make_info.make_info, make.index_set.module_index, make.prereqs_cache.module_deps_result).
:- mode search_foreign_imports_non_intermod_trans_cache(builtin.in, builtin.in, builtin.out) is semidet.
:- pred search_indirect_imports_intermod_cache(make.make_info.make_info, make.index_set.module_index, make.prereqs_cache.module_deps_result).
:- mode search_indirect_imports_intermod_cache(builtin.in, builtin.in, builtin.out) is semidet.
:- pred search_trans_prereqs_cache(make.make_info.make_info, make.prereqs_cache.trans_prereqs_key, make.prereqs_cache.module_deps_result).
:- mode search_trans_prereqs_cache(builtin.in, builtin.in, builtin.out) is semidet.
