:- module check_hlds.pre_typecheck.
:- interface.
:- use_module hlds.
:- use_module list.
:- use_module parse_tree.
:- use_module hlds.hlds_module.
:- use_module parse_tree.error_spec.
:- pred prepare_for_typecheck_module(hlds.hlds_module.module_info, hlds.hlds_module.module_info, list.list(parse_tree.error_spec.error_spec), list.list(parse_tree.error_spec.error_spec)).
:- mode prepare_for_typecheck_module(builtin.in, builtin.out, builtin.in, builtin.out) is det.
