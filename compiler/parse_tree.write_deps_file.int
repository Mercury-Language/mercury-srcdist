:- pred generate_and_write_d_file_hlds(io.text_output_stream, libs.globals.globals, parse_tree.module_baggage.burdened_aug_comp_unit, parse_tree.d_file_deps.avail_module_sets, parse_tree.generate_mmakefile_fragments.maybe_include_trans_opt_rule, io.io, io.io).
