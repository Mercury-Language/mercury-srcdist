:- pred generate_and_write_dep_file_gendep(io.text_output_stream, libs.globals.globals, parse_tree.deps_map.file_or_module, parse_tree.deps_map.deps_map, list.list(parse_tree.error_spec.error_spec), io.io, io.io).
