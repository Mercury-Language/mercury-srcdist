:- module parse_tree.error_sort.
:- interface.
:- use_module libs.
:- use_module list.
:- use_module libs.globals.
:- use_module libs.options.
:- use_module parse_tree.error_spec.
:- type diag_msg_group
    --->    diag_msg_group(
                 parse_tree.error_spec.diag_msg,
                 list.list(parse_tree.error_spec.diag_msg)
            ).
:- func flatten_diag_msg_group(parse_tree.error_sort.diag_msg_group) = list.list(parse_tree.error_spec.diag_msg).
:- func flatten_diag_msg_groups(list.list(parse_tree.error_sort.diag_msg_group)) = list.list(parse_tree.error_spec.diag_msg).
:- pred sort_diag_msg_groups(list.list(parse_tree.error_sort.diag_msg_group), list.list(parse_tree.error_sort.diag_msg_group)).
:- mode sort_diag_msg_groups(builtin.in, builtin.out) is det.
:- pred sort_diag_msgs(list.list(parse_tree.error_spec.diag_msg), list.list(parse_tree.error_spec.diag_msg)).
:- mode sort_diag_msgs(builtin.in, builtin.out) is det.
:- pred sort_std_diag_specs(libs.globals.globals, list.list(parse_tree.error_spec.std_diag_spec), list.list(parse_tree.error_spec.std_diag_spec)).
:- mode sort_std_diag_specs(builtin.in, builtin.in, builtin.out) is det.
:- pred sort_std_diag_specs_opt_table(libs.options.option_table, list.list(parse_tree.error_spec.std_diag_spec), list.list(parse_tree.error_spec.std_diag_spec)).
:- mode sort_std_diag_specs_opt_table(builtin.in, builtin.in, builtin.out) is det.
:- pred standardize_diag_specs(list.list(parse_tree.error_spec.diag_spec), list.list(parse_tree.error_spec.std_diag_spec)).
:- mode standardize_diag_specs(builtin.in, builtin.out) is det.
