:- module check_hlds.switch_candidates.
:- interface.
:- use_module hlds.
:- use_module libs.
:- use_module list.
:- use_module parse_tree.
:- use_module hlds.hlds_goal.
:- use_module hlds.hlds_module.
:- use_module libs.maybe_util.
:- use_module parse_tree.prog_data.
:- type candidate_switch
    --->    candidate_switch(
                 (check_hlds.switch_candidates).cs_var :: parse_tree.prog_data.prog_var,
                 (check_hlds.switch_candidates).cs_cases :: list.list(hlds.hlds_goal.case),
                 (check_hlds.switch_candidates).cs_unreachable_case_goals :: list.list(hlds.hlds_goal.hlds_goal),
                 (check_hlds.switch_candidates).cs_left_over_disjuncts :: list.list(hlds.hlds_goal.hlds_goal),
                 (check_hlds.switch_candidates).cs_rank :: check_hlds.switch_candidates.candidate_switch_rank,
                 (check_hlds.switch_candidates).cs_can_fail :: parse_tree.prog_data.can_fail,
                 (check_hlds.switch_candidates).cs_requant :: libs.maybe_util.need_to_requantify
            ).
:- type candidate_switch_rank
    --->    some_leftover_can_fail(
                 int
            )
    ;       some_leftover_cannot_fail(
                 int
            )
    ;       no_leftover_twoplus_cases_finite_can_fail 
    ;       no_leftover_one_case 
    ;       no_leftover_twoplus_cases_infinite_can_fail 
    ;       no_leftover_twoplus_cases_finite_cannot_fail 
    ;       all_disjuncts_are_unreachable 
    ;       no_leftover_twoplus_cases_explicitly_selected .
:- type maybe_required_switch_var
    --->    nrsv 
    ;       rsv(
                 parse_tree.prog_data.prog_var
            ).
:- pred categorize_candidate_switch(hlds.hlds_module.module_info, check_hlds.switch_candidates.maybe_required_switch_var, parse_tree.prog_data.prog_var, parse_tree.prog_data.mer_type, parse_tree.prog_data.mer_inst, list.list(hlds.hlds_goal.case), list.list(hlds.hlds_goal.hlds_goal), libs.maybe_util.need_to_requantify, check_hlds.switch_candidates.candidate_switch).
:- mode categorize_candidate_switch(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out) is det.
:- pred is_candidate_switch(list.list(hlds.hlds_goal.case), list.list(hlds.hlds_goal.hlds_goal)).
:- mode is_candidate_switch(builtin.in, builtin.in) is semidet.
:- pred select_best_candidate_switch(check_hlds.switch_candidates.candidate_switch, list.list(check_hlds.switch_candidates.candidate_switch), check_hlds.switch_candidates.candidate_switch).
:- mode select_best_candidate_switch(builtin.in, builtin.in, builtin.out) is det.
