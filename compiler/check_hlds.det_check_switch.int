:- module check_hlds.det_check_switch.
:- interface.
:- use_module hlds.
:- use_module list.
:- use_module maybe.
:- use_module parse_tree.
:- use_module check_hlds.det_util.
:- use_module hlds.hlds_goal.
:- use_module hlds.instmap.
:- use_module parse_tree.error_spec.
:- use_module parse_tree.prog_data.
:- type maybe_inform_incomplete_switches
    --->    do_not_inform_incomplete_switches 
    ;       inform_incomplete_switches .
:- type missing_cons_id_info
    --->    missing_cons_id_info(int, int, list.list(parse_tree.error_spec.format_piece), list.list(parse_tree.error_spec.format_piece)).
:- type reported_switch
    --->    reported_switch(parse_tree.prog_data.prog_context, parse_tree.prog_data.prog_var, list.list(hlds.hlds_goal.case)).
:- type switch_context
    --->    switch_context(parse_tree.prog_data.prog_var, check_hlds.det_check_switch.switch_match, list.list(check_hlds.det_check_switch.switch_match)).
:- type switch_match
    --->    switch_match(parse_tree.prog_data.cons_id, maybe.maybe(list.list(parse_tree.prog_data.prog_var))).
:- type why_report_incomplete_switch
    --->    switch_required_to_be_complete 
    ;       inform_incomplete_switch_option .
:- pred det_diagnose_switch_context(check_hlds.det_util.det_info, list.list(check_hlds.det_check_switch.switch_context), list.list(parse_tree.error_spec.format_piece)).
:- mode det_diagnose_switch_context(builtin.in, builtin.in, builtin.out) is det.
:- pred find_missing_cons_ids(check_hlds.det_util.det_info, maybe.maybe(int), hlds.instmap.instmap, list.list(check_hlds.det_check_switch.switch_context), parse_tree.prog_data.prog_var, list.list(hlds.hlds_goal.case), list.list(parse_tree.error_spec.format_piece), string, maybe.maybe(check_hlds.det_check_switch.missing_cons_id_info)).
:- mode find_missing_cons_ids(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.out, builtin.out) is det.
:- pred find_switch_var_matches(list.list(hlds.hlds_goal.hlds_goal), list.list(parse_tree.prog_data.prog_var), parse_tree.prog_data.cons_id, list.list(parse_tree.prog_data.cons_id), check_hlds.det_check_switch.switch_match, list.list(check_hlds.det_check_switch.switch_match)).
:- mode find_switch_var_matches(builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.out) is det.
:- pred reqscope_check_goal(hlds.hlds_goal.hlds_goal, hlds.instmap.instmap, check_hlds.det_check_switch.maybe_inform_incomplete_switches, maybe.maybe(check_hlds.det_check_switch.reported_switch), list.list(check_hlds.det_check_switch.switch_context), check_hlds.det_util.det_info, check_hlds.det_util.det_info).
:- mode reqscope_check_goal(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out) is det.
