:- module hlds.var_origins.
:- interface.
:- use_module list.
:- use_module map.
:- use_module mdbcomp.
:- use_module parse_tree.
:- use_module set.
:- use_module hlds.hlds_goal.
:- use_module hlds.hlds_module.
:- use_module hlds.hlds_pred.
:- use_module hlds.pred_proc_id.
:- use_module mdbcomp.prim_data.
:- use_module mdbcomp.sym_name.
:- use_module parse_tree.error_spec.
:- use_module parse_tree.prog_data.
:- use_module parse_tree.var_table.
:- type lhs_or_rhs
    --->    lor_lhs(
                 (hlds.var_origins).rhs_var :: parse_tree.prog_data.prog_var
            )
    ;       lor_rhs(
                 (hlds.var_origins).lhs_var :: parse_tree.prog_data.prog_var
            ).
:- type lhs_or_rhs_arg
    --->    lora_lhs(
                 (hlds.var_origins).rhs_argvars :: list.list(parse_tree.prog_data.prog_var)
            )
    ;       lora_rhs(
                 (hlds.var_origins).lhs_var :: parse_tree.prog_data.prog_var,
                 (hlds.var_origins).rhs_arg_num :: uint
            ).
:- type record_var_origin(T) == pred(hlds.var_origins.var_origins_map, parse_tree.prog_data.prog_var, hlds.var_origins.var_origin, T, T).
:- type var_origin
    --->    var_origin_clause_head(
                 (hlds.var_origins).voch_context :: parse_tree.prog_data.prog_context,
                 (hlds.var_origins).voch_clause :: uint,
                 (hlds.var_origins).voch_arg_num :: uint
            )
    ;       var_origin_lambda_head(
                 (hlds.var_origins).volh_context :: parse_tree.prog_data.prog_context,
                 (hlds.var_origins).volh_p_or_f :: mdbcomp.prim_data.pred_or_func,
                 (hlds.var_origins).volh_arg_num :: uint
            )
    ;       var_origin_unify_var(
                 (hlds.var_origins).vouv_context :: parse_tree.prog_data.prog_context,
                 (hlds.var_origins).vouv_lorhs :: hlds.var_origins.lhs_or_rhs
            )
    ;       var_origin_unify_func(
                 (hlds.var_origins).vouf_context :: parse_tree.prog_data.prog_context,
                 (hlds.var_origins).vouf_cons_id :: parse_tree.prog_data.cons_id,
                 (hlds.var_origins).vouf_lorhsa :: hlds.var_origins.lhs_or_rhs_arg
            )
    ;       var_origin_plain_call(
                 (hlds.var_origins).vopc_context :: parse_tree.prog_data.prog_context,
                 (hlds.var_origins).vopc_callee_id :: hlds.pred_proc_id.pred_id,
                 (hlds.var_origins).vopc_callee_sn :: mdbcomp.sym_name.sym_name,
                 (hlds.var_origins).vopc_arg_num :: uint
            )
    ;       var_origin_foreign_call(
                 (hlds.var_origins).vofc_context :: parse_tree.prog_data.prog_context,
                 (hlds.var_origins).vofc_callee_id :: hlds.pred_proc_id.pred_id,
                 (hlds.var_origins).vofc_callee_sn :: mdbcomp.sym_name.sym_name,
                 (hlds.var_origins).vofc_arg_num :: uint
            )
    ;       var_origin_generic_call(
                 (hlds.var_origins).vogc_context :: parse_tree.prog_data.prog_context,
                 (hlds.var_origins).vogc_callee :: hlds.hlds_goal.generic_call,
                 (hlds.var_origins).vogc_arg_num :: uint
            ).
:- type var_origins_map == map.map(parse_tree.prog_data.prog_var, set.set(hlds.var_origins.var_origin)).
:- inst record_var_origin == (pred(builtin.in, builtin.in, builtin.in, builtin.in, builtin.out) is det).
:- pred compute_var_origins_in_pred(hlds.var_origins.record_var_origin(T), hlds.hlds_module.module_info, hlds.hlds_pred.pred_info, hlds.var_origins.var_origins_map, T, T).
:- mode compute_var_origins_in_pred(builtin.in((hlds.var_origins).record_var_origin), builtin.in, builtin.in, builtin.out, builtin.in, builtin.out) is det.
:- pred explain_var_origin(hlds.hlds_module.module_info, parse_tree.var_table.var_table, parse_tree.prog_data.prog_var, hlds.var_origins.var_origin, list.list(parse_tree.error_spec.diag_msg)).
:- mode explain_var_origin(builtin.in, builtin.in, builtin.in, builtin.in, builtin.out) is det.
