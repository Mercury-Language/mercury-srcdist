:- pred det_diagnose_conj(hlds.instmap.instmap, list.list(check_hlds.det_check_switch.switch_context), parse_tree.prog_data.determinism, list.list(hlds.hlds_goal.hlds_goal), list.list(parse_tree.error_sort.error_msg_group), check_hlds.det_util.det_info, check_hlds.det_util.det_info).
