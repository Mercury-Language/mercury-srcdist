:- module parse_tree.find_module.
:- interface.
:- use_module io.
:- use_module libs.
:- use_module list.
:- use_module maybe.
:- use_module mdbcomp.
:- use_module time.
:- use_module libs.file_util.
:- use_module libs.globals.
:- use_module libs.options.
:- use_module mdbcomp.sym_name.
:- type dir_name_and_contents
