:- func get_search_auth_interface_dirs(libs.globals.interface_ext, libs.globals.globals) = parse_tree.find_module.search_auth_dirs.
:- func get_search_auth_intermod_dirs(libs.globals.intermod_ext, libs.globals.globals) = parse_tree.find_module.search_auth_dirs.
:- func get_search_auth_lib_dirs(libs.globals.lib_ext, libs.globals.globals) = parse_tree.find_module.search_auth_dirs.
:- func get_search_auth_options_file_dirs(libs.options.option_table) = parse_tree.find_module.search_auth_tail_dirs.
:- func get_search_auth_stdlib_dirs(libs.globals.stdlib_ext, libs.globals.globals) = parse_tree.find_module.search_auth_dirs.
:- pred search_for_file(parse_tree.find_module.search_auth_dirs, libs.file_util.file_name, list.list(libs.file_util.dir_name), maybe.maybe_error(libs.file_util.file_name), io.io, io.io).
