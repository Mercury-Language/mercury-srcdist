:- module (hlds.make_hlds).state_var.
:- interface.
:- type hlds_goal_svar_state.
:- type new_statevar_map.
:- type svar.
:- type svar_inner_atomic_scope_info.
:- type svar_outer_atomic_scope_info.
:- type svar_state.
:- type svar_store.
:- type unravel_info.
:- type_representation(hlds_goal_svar_state, is_word_aligned_ptr).
:- type_representation(last_id_map, is_eqv_to(map(prog_var, uint))).
:- type_representation(new_statevar_map, is_eqv_to(one_or_more_map(prog_var, maybe_statevar_arg_pos))).
:- type_representation(svar, is_eqv_to(prog_var)).
:- type_representation(svar_inner_atomic_scope_info, is_word_aligned_ptr).
:- type_representation(svar_state, du_repn(notag("svar_state", map(svar, svar_status),  no_c_j_cs))).
