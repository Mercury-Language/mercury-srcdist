:- type option_table == getopt.option_table(libs.options.option).
:- pred all_long_option_strings(list.list(string)).
:- mode all_long_option_strings(builtin.out) is det.
:- pred all_negatable_long_option_strings(list.list(string)).
:- mode all_negatable_long_option_strings(builtin.out) is det.
:- func dodgy_code_warning_bool_options = list.list(libs.options.option).
:- pred get_long_option(getopt.long_option(libs.options.option)).
:- mode get_long_option(builtin.out(getopt.long_option)) is det.
:- pred get_option_default_table(getopt.option_default_value_map(libs.options.option)).
:- mode get_option_default_table(builtin.out) is det.
:- pred get_short_option(getopt.short_option(libs.options.option)).
:- mode get_short_option(builtin.out(getopt.short_option)) is det.
:- func info_request_bool_options = list.list(libs.options.option).
:- pred optdb(libs.option_categories.option_category, libs.options.option, getopt.option_data, libs.optdb_help.help).
:- mode optdb(builtin.out, builtin.in, builtin.out, builtin.out) is det.
:- mode optdb(builtin.in, builtin.out, builtin.out, builtin.out) is multi.
:- mode optdb(builtin.out, builtin.out, builtin.out, builtin.out) is multi.
:- pred option_table_add_mercury_library_directory(string, libs.options.option_table, libs.options.option_table).
:- mode option_table_add_mercury_library_directory(builtin.in, builtin.in, builtin.out) is det.
:- pred option_table_add_search_library_files_directory(string, libs.options.option_table, libs.options.option_table).
:- mode option_table_add_search_library_files_directory(builtin.in, builtin.in, builtin.out) is det.
:- func options_not_to_track = list.list(libs.options.option).
:- pred set_all_options_to(list.list(libs.options.option), getopt.option_data, libs.options.option_table, libs.options.option_table).
:- mode set_all_options_to(builtin.in, builtin.in, builtin.in, builtin.out) is det.
:- func slow_code_warning_bool_options = list.list(libs.options.option).
:- pred special_handler(libs.options.option, getopt.special_data, libs.options.option_table, libs.options.maybe_option_table, cord.cord(libs.optimization_options.optimization_option), cord.cord(libs.optimization_options.optimization_option)).
:- mode special_handler(builtin.in, builtin.in, builtin.in, builtin.out, builtin.in, builtin.out) is semidet.
:- func style_warning_bool_options = list.list(libs.options.option).
