:- implementation.
:- type module_to_module_set_cache == map.map(make.index_set.module_index, make.prereqs_cache.module_prereqs_result).
:- type module_to_target_id_set_cache == map.map(make.index_set.module_index, make.prereqs_cache.target_id_prereqs_result).
