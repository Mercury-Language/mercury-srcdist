:- pred get_declared_types_and_maybe_modes(parse_tree.prog_item.types_and_maybe_modes, maybe.maybe(parse_tree.prog_data.mer_inst), maybe.maybe(parse_tree.prog_data.determinism), list.list(parse_tree.prog_data.mer_type), maybe.maybe(list.list(parse_tree.prog_data.mer_mode))).
:- mode get_declared_types_and_maybe_modes(builtin.in, builtin.in, builtin.in, builtin.out, builtin.out) is det.
:- func get_goal_context(parse_tree.prog_item.goal) = parse_tree.prog_data.prog_context.
:- func get_item_context(parse_tree.prog_item.item) = parse_tree.prog_data.prog_context.
