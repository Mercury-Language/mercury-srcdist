:- module ll_backend.var_locn.
:- interface.
:- type maybe_first_death
	where	type_is_abstract_enum(1).
:- type var_locn_info.
:- type_representation(loc_var_map, is_eqv_to(map(lval, set_of_progvar))).
:- type_representation(maybe_first_death, du_repn(enum("first_death", "maybe_not_first_death", [],  no_c_j_cs))).
:- type_representation(var_locn_info, is_word_aligned_ptr).
:- type_representation(var_state_map, is_eqv_to(map(prog_var, var_state))).
