:- module make.order.
:- interface.
:- use_module io.
:- use_module libs.
:- use_module list.
:- use_module map.
:- use_module mdbcomp.
:- use_module libs.globals.
:- use_module make.make_info.
:- use_module mdbcomp.sym_name.
:- pred filter_out_nested_modules(io.text_output_stream, libs.globals.globals, list.list(mdbcomp.sym_name.module_name), list.list(mdbcomp.sym_name.module_name), make.make_info.make_info, make.make_info.make_info, io.io, io.io).
:- mode filter_out_nested_modules(builtin.in, builtin.in, builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred get_bottom_up_ordered_modules(map.map(mdbcomp.sym_name.module_name, make.make_info.maybe_module_dep_info), list.list(mdbcomp.sym_name.module_name), list.list(mdbcomp.sym_name.module_name)).
:- mode get_bottom_up_ordered_modules(builtin.in, builtin.in, builtin.out) is det.
:- pred get_nonnested_and_parent_modules(io.text_output_stream, libs.globals.globals, list.list(mdbcomp.sym_name.module_name), list.list(mdbcomp.sym_name.module_name), list.list(mdbcomp.sym_name.module_name), make.make_info.make_info, make.make_info.make_info, io.io, io.io).
:- mode get_nonnested_and_parent_modules(builtin.in, builtin.in, builtin.in, builtin.out, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred get_target_modules(io.text_output_stream, libs.globals.globals, make.make_info.module_target_type, list.list(mdbcomp.sym_name.module_name), list.list(mdbcomp.sym_name.module_name), make.make_info.make_info, make.make_info.make_info, io.io, io.io).
:- mode get_target_modules(builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred order_target_modules(io.text_output_stream, libs.globals.globals, list.list(mdbcomp.sym_name.module_name), list.list(mdbcomp.sym_name.module_name), make.make_info.make_info, make.make_info.make_info, io.io, io.io).
:- mode order_target_modules(builtin.in, builtin.in, builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
