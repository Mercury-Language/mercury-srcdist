:- module parse_tree.maybe_error.
:- interface.
:- use_module list.
:- use_module one_or_more.
:- use_module parse_tree.error_spec.
:- type maybe1(T1) == parse_tree.maybe_error.maybe1(T1, one_or_more.one_or_more(parse_tree.error_spec.diag_spec)).
:- type maybe1(T1, E)
    --->    error1(
                 E
            )
    ;       ok1(
                 T1
            ).
