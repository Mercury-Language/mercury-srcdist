:- module libs.check_libgrades.
:- interface.
:- use_module io.
:- use_module list.
:- use_module parse_tree.
:- use_module set.
:- use_module libs.globals.
:- use_module libs.options.
:- use_module parse_tree.error_spec.
:- use_module parse_tree.maybe_error.
:- pred detect_stdlib_grades(libs.options.option_table, parse_tree.maybe_error.maybe1(set.set(string)), io.io, io.io).
:- mode detect_stdlib_grades(builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred maybe_check_libraries_are_installed(libs.globals.globals, list.list(parse_tree.error_spec.error_spec), io.io, io.io).
:- mode maybe_check_libraries_are_installed(builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred maybe_libgrade_opts_for_detected_stdlib_grades(libs.options.option_table, list.list(string), io.io, io.io).
:- mode maybe_libgrade_opts_for_detected_stdlib_grades(builtin.in, builtin.out, builtin.di, builtin.uo) is det.
