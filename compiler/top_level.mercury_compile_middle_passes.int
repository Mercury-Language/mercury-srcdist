:- pred middle_pass(io.text_output_stream, io.text_output_stream, libs.op_mode.op_mode_front_and_middle, hlds.hlds_module.module_info, hlds.hlds_module.module_info, hlds.passes_aux.dump_info, hlds.passes_aux.dump_info, parse_tree.error_util.maybe_written_specs, parse_tree.error_util.maybe_written_specs, io.io, io.io).
:- mode middle_pass(builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred middle_pass_for_opt_file(io.text_output_stream, hlds.hlds_module.module_info, hlds.hlds_module.module_info, set.set(parse_tree.prog_item.gen_pragma_unused_args_info), parse_tree.error_util.maybe_written_specs, parse_tree.error_util.maybe_written_specs, io.io, io.io).
:- mode middle_pass_for_opt_file(builtin.in, builtin.in, builtin.out, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred output_analysis_file(io.text_output_stream, hlds.hlds_module.module_info, hlds.passes_aux.dump_info, hlds.passes_aux.dump_info, parse_tree.error_util.maybe_written_specs, parse_tree.error_util.maybe_written_specs, io.io, io.io).
:- mode output_analysis_file(builtin.in, builtin.in, builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred output_trans_opt_file(io.text_output_stream, hlds.hlds_module.module_info, hlds.passes_aux.dump_info, hlds.passes_aux.dump_info, parse_tree.error_util.maybe_written_specs, parse_tree.error_util.maybe_written_specs, io.io, io.io).
