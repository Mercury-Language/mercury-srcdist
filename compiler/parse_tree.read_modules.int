:- mode read_module_int2(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred read_module_int3(io.text_output_stream, libs.globals.globals, parse_tree.read_modules.read_reason_msg, parse_tree.file_names.maybe_search, mdbcomp.sym_name.module_name, libs.timestamp.read_module_and_timestamps, parse_tree.read_modules.have_module(parse_tree.prog_parse_tree.parse_tree_int3), io.io, io.io).
:- mode read_module_int3(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred read_module_plain_opt(io.text_output_stream, libs.globals.globals, mdbcomp.sym_name.module_name, parse_tree.read_modules.have_module(parse_tree.prog_parse_tree.parse_tree_plain_opt), io.io, io.io).
:- mode read_module_plain_opt(builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred read_module_src(io.text_output_stream, libs.globals.globals, parse_tree.read_modules.read_reason_msg, parse_tree.file_names.maybe_search, mdbcomp.sym_name.module_name, list.list(term.context), libs.timestamp.read_module_and_timestamps, parse_tree.read_modules.have_read_module(parse_tree.prog_parse_tree.parse_tree_src), io.io, io.io).
:- mode read_module_src(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
