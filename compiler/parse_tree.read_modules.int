:- pred maybe_read_module_int3(io.text_output_stream, libs.globals.globals, parse_tree.file_names.maybe_search, mdbcomp.sym_name.module_name, libs.timestamp.maybe_return_timestamp, parse_tree.read_modules.have_module(parse_tree.prog_parse_tree.parse_tree_int3), parse_tree.read_modules.have_parse_tree_maps, parse_tree.read_modules.have_parse_tree_maps, io.io, io.io).
:- mode maybe_read_module_int3(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred read_module_int0(io.text_output_stream, libs.globals.globals, parse_tree.read_modules.read_reason_msg, parse_tree.file_names.maybe_search, mdbcomp.sym_name.module_name, libs.timestamp.read_module_and_timestamps, parse_tree.read_modules.have_module(parse_tree.prog_parse_tree.parse_tree_int0), io.io, io.io).
:- mode read_module_int0(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
