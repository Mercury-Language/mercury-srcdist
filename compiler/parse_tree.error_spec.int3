:- module parse_tree.error_spec.
:- interface.
:- type actual_severity
	where	type_is_abstract_enum(2).
:- type color_name
	where	type_is_abstract_enum(3).
:- type diag_msg.
:- type diag_msg_component.
:- type diag_spec.
:- type err_spec
	where	type_is_abstract_subtype(diag_spec/0).
:- type errs_warns.
:- type format_piece.
:- type info_spec
	where	type_is_abstract_subtype(diag_spec/0).
:- type lp_piece_kind
	where	type_is_abstract_enum(1).
:- type maybe_always_treat_as_first
	where	type_is_abstract_enum(1).
:- type mode_report_control
	where	type_is_abstract_enum(1).
:- type module_file_id.
:- type rp_piece_kind
	where	type_is_abstract_enum(1).
:- type spec_phase.
:- type spec_severity.
:- type spec_severity_err
	where	type_is_abstract_subtype(spec_severity/0).
:- type spec_severity_info
	where	type_is_abstract_subtype(spec_severity/0).
:- type spec_severity_warn
	where	type_is_abstract_subtype(spec_severity/0).
:- type std_diag_msg
	where	type_is_abstract_subtype(diag_msg/0).
:- type std_diag_spec
	where	type_is_abstract_subtype(diag_spec/0).
:- type verbose_always_or_once
	where	type_is_abstract_enum(1).
:- type warn_spec
	where	type_is_abstract_subtype(diag_spec/0).
:- type_representation(actual_severity, du_repn(enum("actual_severity_error", "actual_severity_warning", ["actual_severity_informational"],  no_c_j_cs))).
:- type_representation(color_name, du_repn(enum("color_subject", "color_correct", ["color_incorrect", "color_inconsistent", "color_hint"],  no_c_j_cs))).
:- type_representation(err_spec, is_subtype_of((parse_tree.error_spec).diag_spec/0)).
:- type_representation(errs_warns, is_word_aligned_ptr).
:- type_representation(info_spec, is_subtype_of((parse_tree.error_spec).diag_spec/0)).
:- type_representation(lp_piece_kind, du_repn(enum("lp_plain", "lp_suffix", [],  no_c_j_cs))).
:- type_representation(maybe_always_treat_as_first, du_repn(enum("always_treat_as_first", "treat_based_on_posn", [],  no_c_j_cs))).
:- type_representation(mode_report_control, du_repn(enum("report_in_any_mode", "report_only_if_in_all_modes", [],  no_c_j_cs))).
:- type_representation(module_file_id, is_word_aligned_ptr).
:- type_representation(rp_piece_kind, du_repn(enum("rp_plain", "rp_prefix", [],  no_c_j_cs))).
:- type_representation(spec_severity_err, is_subtype_of((parse_tree.error_spec).spec_severity/0)).
:- type_representation(spec_severity_info, is_subtype_of((parse_tree.error_spec).spec_severity/0)).
:- type_representation(spec_severity_warn, is_subtype_of((parse_tree.error_spec).spec_severity/0)).
:- type_representation(std_diag_msg, is_subtype_of((parse_tree.error_spec).diag_msg/0)).
:- type_representation(std_diag_spec, is_subtype_of((parse_tree.error_spec).diag_spec/0)).
:- type_representation(verbose_always_or_once, du_repn(enum("verbose_always", "verbose_once", [],  no_c_j_cs))).
:- type_representation(warn_spec, is_subtype_of((parse_tree.error_spec).diag_spec/0)).
