:- module (hlds.make_hlds).check_field_access_functions.
:- interface.
:- use_module list.
:- use_module mdbcomp.
:- use_module parse_tree.
:- use_module hlds.hlds_module.
:- use_module hlds.status.
:- use_module mdbcomp.sym_name.
:- use_module parse_tree.error_spec.
:- use_module parse_tree.prog_data.
:- use_module parse_tree.prog_item.
:- use_module (hlds.make_hlds).make_hlds_types.
:- pred check_preds_if_field_access_function(hlds.hlds_module.module_info, hlds.make_hlds.make_hlds_types.sec_list(parse_tree.prog_item.item_pred_decl_info), list.list(parse_tree.error_spec.diag_spec), list.list(parse_tree.error_spec.diag_spec)).
:- mode check_preds_if_field_access_function(builtin.in, builtin.in, builtin.in, builtin.out) is det.
:- pred maybe_check_field_access_function(hlds.hlds_module.module_info, mdbcomp.sym_name.sym_name, parse_tree.prog_data.user_arity, hlds.status.pred_status, parse_tree.prog_data.prog_context, list.list(parse_tree.error_spec.diag_spec), list.list(parse_tree.error_spec.diag_spec)).
:- mode maybe_check_field_access_function(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out) is det.
