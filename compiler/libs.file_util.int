:- module libs.file_util.
:- interface.
:- use_module bool.
:- use_module io.
:- use_module list.
:- use_module maybe.
:- use_module parse_tree.
:- use_module libs.globals.
:- use_module libs.maybe_util.
:- use_module parse_tree.error_spec.
:- type dir_name == string.
:- type file_name == string.
:- pred compare_file_timestamps(libs.file_util.file_name, libs.file_util.file_name, maybe.maybe(builtin.comparison_result), io.io, io.io).
:- mode compare_file_timestamps(builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- func construct_spec_for_cannot_open_file_for_input(libs.file_util.file_name, maybe.maybe(parse_tree.error_spec.module_file_id), io.error) = parse_tree.error_spec.diag_spec.
:- func construct_spec_for_cannot_open_file_for_output(libs.file_util.file_name, io.error) = parse_tree.error_spec.diag_spec.
:- pred get_install_name_option(libs.globals.globals, string, string).
:- mode get_install_name_option(builtin.in, builtin.in, builtin.out) is det.
:- pred get_std_grade_specific_install_lib_dir(libs.globals.globals, string, string).
:- mode get_std_grade_specific_install_lib_dir(builtin.in, builtin.in, builtin.out) is det.
:- func make_install_file_command(libs.globals.globals, string, string) = string.
:- pred maybe_flush_output(io.text_output_stream, bool.bool, io.io, io.io).
:- mode maybe_flush_output(builtin.in, builtin.in, builtin.di, builtin.uo) is det.
:- pred maybe_flush_output_to_stream(maybe.maybe(io.text_output_stream), io.io, io.io).
:- mode maybe_flush_output_to_stream(builtin.in, builtin.di, builtin.uo) is det.
:- pred maybe_report_stats(io.text_output_stream, bool.bool, io.io, io.io).
:- mode maybe_report_stats(builtin.in, builtin.in, builtin.di, builtin.uo) is det.
:- pred maybe_report_stats_to_stream(maybe.maybe(io.text_output_stream), io.io, io.io).
:- mode maybe_report_stats_to_stream(builtin.in, builtin.di, builtin.uo) is det.
:- pred maybe_write_string(io.text_output_stream, bool.bool, string, io.io, io.io).
:- mode maybe_write_string(builtin.in, builtin.in, builtin.in, builtin.di, builtin.uo) is det.
:- pred maybe_write_string_to_stream(maybe.maybe(io.text_output_stream), string, io.io, io.io).
:- mode maybe_write_string_to_stream(builtin.in, builtin.in, builtin.di, builtin.uo) is det.
:- pred open_temp_output(maybe.maybe_error({string, io.text_output_stream}), io.io, io.io).
:- mode open_temp_output(builtin.out, builtin.di, builtin.uo) is det.
:- pred open_temp_output_with_naming_scheme(string, string, string, maybe.maybe_error({string, io.text_output_stream}), io.io, io.io).
:- mode open_temp_output_with_naming_scheme(builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred output_to_file_stream(io.text_output_stream, libs.globals.globals, string, pred(io.text_output_stream, list.list(string), io.io, io.io), libs.maybe_util.maybe_succeeded, io.io, io.io).
:- mode output_to_file_stream(builtin.in, builtin.in, builtin.in, builtin.in((pred(builtin.in, builtin.out, builtin.di, builtin.uo) is det)), builtin.out, builtin.di, builtin.uo) is det.
:- pred report_arbitrary_error(io.text_output_stream, string, io.io, io.io).
:- mode report_arbitrary_error(builtin.in, builtin.in, builtin.di, builtin.uo) is det.
:- pred report_cannot_open_file_for_input(io.text_output_stream, libs.globals.globals, libs.file_util.file_name, io.error, io.io, io.io).
:- mode report_cannot_open_file_for_input(builtin.in, builtin.in, builtin.in, builtin.in, builtin.di, builtin.uo) is det.
:- pred report_cannot_open_file_for_input_nc(io.text_output_stream, libs.file_util.file_name, io.error, io.io, io.io).
:- mode report_cannot_open_file_for_input_nc(builtin.in, builtin.in, builtin.in, builtin.di, builtin.uo) is det.
:- pred report_cannot_open_file_for_output(io.text_output_stream, libs.globals.globals, libs.file_util.file_name, io.error, io.io, io.io).
:- mode report_cannot_open_file_for_output(builtin.in, builtin.in, builtin.in, builtin.in, builtin.di, builtin.uo) is det.
:- pred report_cannot_open_file_for_output_nc(io.text_output_stream, libs.file_util.file_name, io.error, io.io, io.io).
:- mode report_cannot_open_file_for_output_nc(builtin.in, builtin.in, builtin.in, builtin.di, builtin.uo) is det.
:- pred write_include_file_contents(io.text_output_stream, libs.globals.globals, string, maybe.maybe_error, io.io, io.io).
:- mode write_include_file_contents(builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred write_string_to_file(io.text_output_stream, libs.globals.globals, string, libs.file_util.file_name, string, libs.maybe_util.maybe_succeeded, io.io, io.io).
:- mode write_string_to_file(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
