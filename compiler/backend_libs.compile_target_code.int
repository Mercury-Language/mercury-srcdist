:- module backend_libs.compile_target_code.
:- interface.
:- use_module bool.
:- use_module io.
:- use_module libs.
:- use_module list.
:- use_module maybe.
:- use_module mdbcomp.
:- use_module parse_tree.
:- use_module libs.file_util.
:- use_module libs.globals.
:- use_module libs.maybe_util.
:- use_module mdbcomp.sym_name.
:- use_module parse_tree.file_names.
:- use_module parse_tree.module_dep_info.
:- type pic
    --->    pic 
    ;       non_pic .
:- inst ext_cur_ngs_gas_init_obj for (parse_tree.file_names).ext_cur_ngs_gas/0
    --->    ext_cur_ngs_gas_init_obj_obj_opt
    ;       ext_cur_ngs_gas_init_obj_pic_obj_opt.
:- inst ext_cur_ngs_gas_obj for (parse_tree.file_names).ext_cur_ngs_gas/0
    --->    ext_cur_ngs_gas_obj_obj_opt
    ;       ext_cur_ngs_gas_obj_pic_obj_opt.
:- pred compile_c_file(libs.globals.globals, io.text_output_stream, backend_libs.compile_target_code.pic, mdbcomp.sym_name.module_name, libs.maybe_util.maybe_succeeded, io.io, io.io).
:- mode compile_c_file(builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred compile_csharp_file(libs.globals.globals, io.text_output_stream, parse_tree.module_dep_info.module_dep_info, libs.file_util.file_name, libs.file_util.file_name, libs.maybe_util.maybe_succeeded, io.io, io.io).
:- mode compile_csharp_file(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred compile_java_files(libs.globals.globals, io.text_output_stream, string, list.list(string), libs.maybe_util.maybe_succeeded, io.io, io.io).
:- mode compile_java_files(builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred do_compile_c_file(libs.globals.globals, io.text_output_stream, backend_libs.compile_target_code.pic, string, string, libs.maybe_util.maybe_succeeded, io.io, io.io).
:- mode do_compile_c_file(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred do_make_init_obj_file(libs.globals.globals, io.text_output_stream, bool.bool, mdbcomp.sym_name.module_name, list.list(mdbcomp.sym_name.module_name), maybe.maybe(libs.file_util.file_name), io.io, io.io).
:- mode do_make_init_obj_file(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
