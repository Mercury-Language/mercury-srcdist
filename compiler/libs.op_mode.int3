:- module libs.op_mode.
:- interface.
:- type maybe_make_ints
	where	type_is_abstract_enum(1).
:- type op_mode.
:- type op_mode_args.
:- type op_mode_augment.
:- type op_mode_codegen
	where	type_is_abstract_subtype(op_mode_front_and_middle/0).
:- type op_mode_front_and_middle
	where	type_is_abstract_enum(2).
:- type op_mode_interface_file
	where	type_is_abstract_enum(2).
:- type op_mode_invoked_by_mmc_make
	where	type_is_abstract_enum(1).
:- type op_mode_query
	where	type_is_abstract_enum(4).
:- type_representation(maybe_make_ints, du_repn(enum("do_not_make_ints", "do_make_ints", [],  no_c_j_cs))).
:- type_representation(op_mode_codegen, is_subtype_of((libs.op_mode).op_mode_front_and_middle/0)).
:- type_representation(op_mode_front_and_middle, du_repn(enum("opfam_errorcheck_only", "opfam_target_code_only", ["opfam_target_and_object_code_only", "opfam_target_object_and_executable"],  no_c_j_cs))).
:- type_representation(op_mode_interface_file, du_repn(enum("omif_int0", "omif_int1_int2", ["omif_int3"],  no_c_j_cs))).
:- type_representation(op_mode_invoked_by_mmc_make, du_repn(enum("op_mode_not_invoked_by_mmc_make", "op_mode_invoked_by_mmc_make", [],  no_c_j_cs))).
:- type_representation(op_mode_query, du_repn(enum("opmq_output_cc", "opmq_output_c_compiler_type", ["opmq_output_cflags", "opmq_output_c_include_directory_flags", "opmq_output_grade_defines", "opmq_output_csharp_compiler", "opmq_output_csharp_compiler_type", "opmq_output_java_class_dir", "opmq_output_link_command", "opmq_output_shared_lib_link_command", "opmq_output_library_link_flags", "opmq_output_grade_string", "opmq_output_libgrades", "opmq_output_stdlib_grades", "opmq_output_stdlib_modules", "opmq_output_target_arch"],  no_c_j_cs))).
