:- module libs.optdb_help.
:- interface.
:- type arg_align.
:- type help.
:- type help_piece.
:- type help_public_or_private
	where	type_is_abstract_enum(1).
:- type help_text.
:- type_representation(arg_align, is_word_aligned_ptr).
:- type_representation(help_public_or_private, du_repn(enum("help_public", "help_private", [],  no_c_j_cs))).
:- type_representation(help_text, is_eqv_to(list(libs.optdb_help.help_piece))).
