:- module top_level.mercury_compile_mlds_back_end.
:- interface.
:- use_module hlds.
:- use_module io.
:- use_module libs.
:- use_module ml_backend.
:- use_module parse_tree.
:- use_module hlds.hlds_module.
:- use_module hlds.passes_aux.
:- use_module libs.globals.
:- use_module libs.maybe_util.
:- use_module ml_backend.mlds.
:- use_module parse_tree.error_util.
:- pred hlds_to_mlds(io.text_output_stream, hlds.hlds_module.module_info, ml_backend.mlds.mlds, hlds.passes_aux.dump_info, hlds.passes_aux.dump_info, parse_tree.error_util.maybe_written_specs, parse_tree.error_util.maybe_written_specs, io.io, io.io).
:- mode hlds_to_mlds(builtin.in, builtin.in, builtin.out, builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred mlds_to_csharp(io.text_output_stream, hlds.hlds_module.module_info, ml_backend.mlds.mlds, libs.maybe_util.maybe_succeeded, io.io, io.io).
:- mode mlds_to_csharp(builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred mlds_to_high_level_c(io.text_output_stream, libs.globals.globals, ml_backend.mlds.mlds, libs.maybe_util.maybe_succeeded, io.io, io.io).
:- mode mlds_to_high_level_c(builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred mlds_to_java(io.text_output_stream, hlds.hlds_module.module_info, ml_backend.mlds.mlds, libs.maybe_util.maybe_succeeded, io.io, io.io).
:- mode mlds_to_java(builtin.in, builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
