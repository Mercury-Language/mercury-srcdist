:- module make.top_level.
:- interface.
:- use_module io.
:- use_module libs.
:- use_module list.
:- use_module libs.file_util.
:- use_module libs.globals.
:- use_module libs.maybe_util.
:- use_module make.make_info.
:- use_module make.options_file.
:- pred make_process_compiler_args(io.text_output_stream, libs.globals.globals, make.options_file.env_optfile_variables, list.list(string), list.list(string), list.list(libs.file_util.file_name), io.io, io.io).
:- mode make_process_compiler_args(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.di, builtin.uo) is det.
:- pred make_top_targets(io.text_output_stream, libs.globals.globals, make.make_info.maybe_keep_going, list.list(make.make_info.top_target_file), libs.maybe_util.maybe_succeeded, libs.maybe_util.maybe_succeeded, make.make_info.make_info, make.make_info.make_info, io.io, io.io).
:- mode make_top_targets(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
