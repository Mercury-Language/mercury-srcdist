:- module libs.handle_options.
:- interface.
:- use_module io.
:- use_module list.
:- use_module parse_tree.
:- use_module libs.globals.
:- use_module libs.options.
:- use_module parse_tree.error_spec.
:- use_module parse_tree.maybe_error.
:- pred generate_default_globals(io.text_output_stream, libs.options.option_table, libs.globals.globals, io.io, io.io).
:- mode generate_default_globals(builtin.in, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred handle_given_options(io.text_output_stream, libs.options.option_table, libs.globals.maybe_stdlib_grades, parse_tree.maybe_error.maybe1el(list.list(string)), list.list(string), list.list(string), list.list(string), list.list(parse_tree.error_spec.diag_spec), libs.globals.globals, io.io, io.io).
:- mode handle_given_options(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.out, builtin.out, builtin.out, builtin.di, builtin.uo) is det.
:- pred usage_errors(io.text_output_stream, libs.globals.globals, list.list(parse_tree.error_spec.diag_spec), io.io, io.io).
:- mode usage_errors(builtin.in, builtin.in, builtin.in, builtin.di, builtin.uo) is det.
