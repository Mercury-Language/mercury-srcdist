:- module libs.print_help.
:- interface.
:- type print_what_help
	where	type_is_abstract_enum(1).
:- type_representation(cur_line, is_eqv_to(cord(string))).
:- type_representation(finished_lines, is_eqv_to(cord(string))).
:- type_representation(initial_bool_value_map, is_eqv_to(map(option, bool))).
:- type_representation(print_what_help, du_repn(enum("print_public_help", "print_public_and_private_help", [],  no_c_j_cs))).
:- type_representation(set_at_opt_level_map, is_eqv_to(one_or_more_map(option, set_at_opt_level))).
