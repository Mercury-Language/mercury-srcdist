:- module libs.print_help.
:- interface.
:- use_module io.
:- use_module maybe.
:- type print_what_help
    --->    print_public_help 
    ;       print_public_and_private_help .
:- pred list_optimization_options(io.text_output_stream, maybe.maybe(int), io.io, io.io).
:- mode list_optimization_options(builtin.in, builtin.in, builtin.di, builtin.uo) is det.
:- pred long_usage(io.text_output_stream, libs.print_help.print_what_help, io.io, io.io).
:- mode long_usage(builtin.in, builtin.in, builtin.di, builtin.uo) is det.
:- pred short_usage(io.text_output_stream, io.io, io.io).
:- mode short_usage(builtin.in, builtin.di, builtin.uo) is det.
:- pred write_copyright_notice(io.text_output_stream, io.io, io.io).
:- mode write_copyright_notice(builtin.in, builtin.di, builtin.uo) is det.
