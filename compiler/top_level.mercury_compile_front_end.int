:- pred maybe_simplify(io.text_output_stream, maybe.maybe(io.text_output_stream), bool.bool, top_level.mercury_compile_front_end.simplify_pass, bool.bool, bool.bool, hlds.hlds_module.module_info, hlds.hlds_module.module_info, parse_tree.error_util.maybe_written_specs, parse_tree.error_util.maybe_written_specs, io.io, io.io).
