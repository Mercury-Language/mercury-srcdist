:- module check_hlds.unused_types.
:- interface.
:- use_module hlds.
:- use_module list.
:- use_module parse_tree.
:- use_module hlds.hlds_module.
:- use_module parse_tree.error_spec.
:- pred warn_about_unused_types(hlds.hlds_module.module_info, list.list(parse_tree.error_spec.error_spec), list.list(parse_tree.error_spec.error_spec)).
:- mode warn_about_unused_types(builtin.in, builtin.in, builtin.out) is det.
