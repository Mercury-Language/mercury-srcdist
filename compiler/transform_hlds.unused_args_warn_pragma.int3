:- module transform_hlds.unused_args_warn_pragma.
:- interface.
:- type maybe_gather_pragma_unused_args
	where	type_is_abstract_enum(1).
:- type maybe_record_analysis_unused_args
	where	type_is_abstract_enum(1).
:- type maybe_warn_unused_args
	where	type_is_abstract_enum(1).
:- type_representation(maybe_gather_pragma_unused_args, du_repn(enum("do_not_gather_pragma_unused_args", "do_gather_pragma_unused_args", [],  no_c_j_cs))).
:- type_representation(maybe_record_analysis_unused_args, du_repn(enum("do_not_record_analysis_unused_args", "do_record_analysis_unused_args", [],  no_c_j_cs))).
:- type_representation(maybe_warn_unused_args, du_repn(enum("do_not_warn_unused_args", "do_warn_unused_args", [],  no_c_j_cs))).
