:- type inst_ctor_checked_map == map.map(parse_tree.prog_data.inst_ctor, parse_tree.prog_item_inst_mode.inst_ctor_checked_defn).
:- type item_inst_defn_info == parse_tree.prog_item_inst_mode.item_inst_defn_info_general(parse_tree.prog_item_inst_mode.maybe_abstract_inst_defn).
:- type item_inst_defn_info_abstract == parse_tree.prog_item_inst_mode.item_inst_defn_info_general(parse_tree.prog_item_inst_mode.no_inst_defn).
:- type item_inst_defn_info_eqv == parse_tree.prog_item_inst_mode.item_inst_defn_info_general(parse_tree.prog_data.inst_defn).
:- type item_inst_defn_info_general(T)
    --->    item_inst_defn_info(
                 (parse_tree.prog_item_inst_mode).id_inst_name :: mdbcomp.sym_name.sym_name,
                 (parse_tree.prog_item_inst_mode).id_inst_args :: list.list(parse_tree.prog_data.inst_var),
                 (parse_tree.prog_item_inst_mode).id_maybe_for_type :: maybe.maybe(parse_tree.prog_data.type_ctor),
                 (parse_tree.prog_item_inst_mode).id_inst_defn :: T,
                 (parse_tree.prog_item_inst_mode).id_varset :: parse_tree.prog_data.inst_varset,
                 (parse_tree.prog_item_inst_mode).id_context :: parse_tree.prog_data.prog_context,
                 (parse_tree.prog_item_inst_mode).id_seq_num :: parse_tree.prog_data.item_seq_num
            ).
:- type item_mode_defn_info == parse_tree.prog_item_inst_mode.item_mode_defn_info_general(parse_tree.prog_item_inst_mode.maybe_abstract_mode_defn).
:- type item_mode_defn_info_abstract == parse_tree.prog_item_inst_mode.item_mode_defn_info_general(parse_tree.prog_item_inst_mode.no_mode_defn).
:- type item_mode_defn_info_eqv == parse_tree.prog_item_inst_mode.item_mode_defn_info_general(parse_tree.prog_data.mode_defn).
:- type item_mode_defn_info_general(T)
    --->    item_mode_defn_info(
