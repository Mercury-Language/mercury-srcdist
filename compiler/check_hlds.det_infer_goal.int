:- pred det_infer_proc_goal(hlds.instmap.instmap, check_hlds.det_infer_goal.soln_context, parse_tree.prog_data.determinism, hlds.hlds_goal.hlds_goal, hlds.hlds_goal.hlds_goal, check_hlds.det_util.det_info, check_hlds.det_util.det_info).
:- mode det_infer_proc_goal(builtin.in, builtin.in, builtin.out, builtin.in, builtin.out, builtin.in, builtin.out) is det.
