:- module check_hlds.det_infer_goal.
:- interface.
:- use_module hlds.
:- use_module parse_tree.
:- use_module check_hlds.det_util.
:- use_module hlds.hlds_goal.
:- use_module hlds.instmap.
:- use_module parse_tree.prog_data.
:- type soln_context
    --->    all_solns 
    ;       first_soln .
:- pred det_get_soln_context(parse_tree.prog_data.determinism, check_hlds.det_infer_goal.soln_context).
