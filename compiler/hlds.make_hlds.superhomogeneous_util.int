:- module (hlds.make_hlds).superhomogeneous_util.
:- interface.
:- use_module cord.
:- use_module list.
:- use_module mdbcomp.
:- use_module parse_tree.
:- use_module hlds.hlds_goal.
:- use_module hlds.hlds_pred.
:- use_module mdbcomp.prim_data.
:- use_module parse_tree.prog_data.
:- use_module (hlds.make_hlds).state_var.
:- type arg_context
    --->    ac_head(
                 mdbcomp.prim_data.pred_or_func,
                 parse_tree.prog_data.pred_form_arity
            )
    ;       ac_call(
                 hlds.hlds_pred.call_id
            )
    ;       ac_functor(
                 parse_tree.prog_data.cons_id,
                 hlds.hlds_goal.unify_main_context,
                 list.list(hlds.hlds_goal.unify_sub_context)
            ).
:- type expansion
    --->    expansion(
                 hlds.make_hlds.superhomogeneous_util.maybe_fgti_var_size,
                 cord.cord(hlds.hlds_goal.hlds_goal)
            ).
:- type maybe_fgti_var_size
    --->    not_fgti 
    ;       fgti_var_size(
                 parse_tree.prog_data.prog_var,
                 int
            ).
:- type unify_var_term
    --->    unify_var_term(
                 parse_tree.prog_data.prog_var,
                 parse_tree.prog_data.prog_term
            ).
:- type unify_var_term_num_context
    --->    unify_var_term_num_context(
                 parse_tree.prog_data.prog_var,
                 parse_tree.prog_data.prog_term,
                 int,
                 hlds.make_hlds.superhomogeneous_util.arg_context
            ).
:- pred make_fresh_arg_var_no_svar(parse_tree.prog_data.prog_term, parse_tree.prog_data.prog_var, list.list(parse_tree.prog_data.prog_var), hlds.make_hlds.state_var.unravel_info, hlds.make_hlds.state_var.unravel_info).
:- mode make_fresh_arg_var_no_svar(builtin.in, builtin.out, builtin.in, builtin.in, builtin.out) is det.
:- pred make_fresh_arg_vars_subst_svars(list.list(parse_tree.prog_data.prog_term), list.list(parse_tree.prog_data.prog_var), list.list(hlds.make_hlds.superhomogeneous_util.unify_var_term), hlds.make_hlds.state_var.svar_state, hlds.make_hlds.state_var.svar_state, hlds.make_hlds.state_var.unravel_info, hlds.make_hlds.state_var.unravel_info).
:- mode make_fresh_arg_vars_subst_svars(builtin.in, builtin.out, builtin.out, builtin.in, builtin.out, builtin.in, builtin.out) is det.
:- pred pair_vars_with_terms(list.list(parse_tree.prog_data.prog_var), list.list(parse_tree.prog_data.prog_term), list.list(hlds.make_hlds.superhomogeneous_util.unify_var_term)).
:- mode pair_vars_with_terms(builtin.in, builtin.in, builtin.out) is det.
