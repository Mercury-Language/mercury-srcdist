:- module libs.lp.
:- interface.
:- use_module list.
:- use_module map.
:- use_module pair.
:- use_module term.
:- use_module varset.
:- type coeff == pair.pair(term.var, float).
:- type direction
    --->    max 
    ;       min .
:- type equation
    --->    eqn(
                 list.list(libs.lp.coeff),
                 libs.lp.operator,
                 float
            ).
:- type objective == list.list(libs.lp.coeff).
:- type operator
    --->    op_le 
    ;       op_eq 
    ;       op_ge .
:- type result
    --->    unsatisfiable 
    ;       satisfiable(
                 float,
                 map.map(term.var, float)
            ).
:- pred lp_solve(list.list(libs.lp.equation), libs.lp.direction, libs.lp.objective, varset.varset, list.list(term.var), libs.lp.result).
:- mode lp_solve(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out) is det.
