:- func project_pred_form_arity_int(parse_tree.prog_data.pred_form_arity) = int.
:- func project_user_arity_int(parse_tree.prog_data.user_arity) = int.
:- pred unify_context_first_to_pieces(libs.maybe_util.is_first, libs.maybe_util.is_first, hlds.hlds_goal.unify_context, hlds.hlds_error_util.last_context_word, list.list(parse_tree.error_spec.format_piece), list.list(parse_tree.error_spec.format_piece)).
