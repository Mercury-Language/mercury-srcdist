:- func describe_one_proc_name_maybe_argmodes(hlds.hlds_module.module_info, parse_tree.parse_tree_out_info.output_lang, maybe.maybe(parse_tree.error_spec.color_name), hlds.hlds_error_util.should_module_qualify, list.list(parse_tree.error_spec.format_piece), hlds.pred_proc_id.pred_proc_id) = list.list(parse_tree.error_spec.format_piece).
