:- type should_module_qualify
    --->    should_module_qualify 
    ;       should_not_module_qualify .
:- func describe_one_call_site(hlds.hlds_module.module_info, maybe.maybe(parse_tree.error_spec.color_name), hlds.hlds_error_util.should_module_qualify, pair.pair(hlds.hlds_pred.pred_proc_id, parse_tree.prog_data.prog_context)) = list.list(parse_tree.error_spec.format_piece).
