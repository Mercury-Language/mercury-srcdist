:- func call_id_to_pieces(hlds.hlds_error_util.maybe_print_ho_var_name, hlds.hlds_goal.call_id) = list.list(parse_tree.error_spec.format_piece).
:- pred cons_id_may_be_list_cons(parse_tree.prog_data.cons_id).
:- mode cons_id_may_be_list_cons(builtin.in) is semidet.
:- func describe_one_call_site(hlds.hlds_module.module_info, maybe.maybe(parse_tree.error_spec.color_name), hlds.hlds_error_util.should_module_qualify, pair.pair(hlds.pred_proc_id.pred_proc_id, parse_tree.prog_data.prog_context)) = list.list(parse_tree.error_spec.format_piece).
