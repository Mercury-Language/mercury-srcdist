:- use_module parse_tree.parse_tree_out_info.
:- use_module parse_tree.prog_data.
:- use_module parse_tree.var_db.
:- type last_context_word
    --->    lcw_none 
    ;       lcw_call 
    ;       lcw_result 
    ;       lcw_argument 
    ;       lcw_element .
:- type maybe_print_ho_var_name
    --->    do_not_print_ho_var_name 
    ;       print_ho_var_name .
:- type should_module_qualify
    --->    should_module_qualify 
    ;       should_not_module_qualify .
:- func argument_to_pieces(hlds.hlds_goal.unify_sub_context) = list.list(parse_tree.error_spec.format_piece).
