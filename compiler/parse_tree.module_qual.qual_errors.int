:- pred report_ambiguous_match(parse_tree.module_qual.qual_errors.mq_error_context, parse_tree.module_qual.id_set.mq_id, parse_tree.module_qual.id_set.qual_id_kind, list.list(mdbcomp.sym_name.module_name), list.list(mdbcomp.sym_name.module_name), parse_tree.error_spec.diag_spec).
