:- module transform_hlds.unneeded_code.
:- interface.
:- use_module hlds.
:- use_module io.
:- use_module hlds.hlds_module.
:- use_module hlds.hlds_proc.
:- use_module hlds.pred_proc_id.
:- pred unneeded_process_proc_msg(io.text_output_stream, hlds.pred_proc_id.pred_proc_id, hlds.hlds_proc.proc_info, hlds.hlds_proc.proc_info, hlds.hlds_module.module_info, hlds.hlds_module.module_info).
:- mode unneeded_process_proc_msg(builtin.in, builtin.in, builtin.in, builtin.out, builtin.in, builtin.out) is det.
