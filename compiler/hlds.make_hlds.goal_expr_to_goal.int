    --->    loc_whole_goal 
    ;       loc_inside_atomic_goal .
:- pred transform_parse_tree_goal_to_hlds(hlds.make_hlds.goal_expr_to_goal.loc_kind, parse_tree.prog_data.prog_var_renaming, parse_tree.prog_item.goal, hlds.hlds_goal.hlds_goal, hlds.make_hlds.state_var.svar_state, hlds.make_hlds.state_var.svar_state, hlds.make_hlds.state_var.unravel_info, hlds.make_hlds.state_var.unravel_info).
:- mode transform_parse_tree_goal_to_hlds(builtin.in, builtin.in, builtin.in, builtin.out, builtin.in, builtin.out, builtin.in, builtin.out) is det.
