:- module (hlds.make_hlds).goal_expr_to_goal.
:- interface.
:- use_module parse_tree.
:- use_module hlds.hlds_goal.
:- use_module parse_tree.prog_data.
:- use_module parse_tree.prog_item.
:- use_module (hlds.make_hlds).state_var.
