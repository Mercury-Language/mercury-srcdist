:- func term2_info_get_size_var_map(termination.term_constr.term_constr_main_types.termination2_info) = termination.term_constr.term_constr_data.size_var_map.
:- func term2_info_get_success_constrs(termination.term_constr.term_constr_main_types.termination2_info) = maybe.maybe(termination.term_constr.term_constr_main_types.constr_arg_size_info).
:- func term2_info_get_term_status(termination.term_constr.term_constr_main_types.termination2_info) = maybe.maybe(termination.term_constr.term_constr_main_types.constr_termination_info).
