:- module check_hlds.switch_detection.
:- interface.
:- type found_deconstruct
	where	type_is_abstract_enum(1).
:- type process_unify(Result, Info).
:- type switch_detect_info.
:- abstract_inst((goal_expr_deconstruct)).
:- abstract_inst((process_unify)).
:- type_representation(all_arms_summary_map, is_eqv_to(map(prog_var, var_all_arms_summary))).
:- type_representation(disjunct_info_map, is_eqv_to(map(disjunct_id, disjunct_info))).
:- type_representation(disjunction_info_map, is_eqv_to(map(disjunction_id, disjunction_info))).
:- type_representation(found_deconstruct, du_repn(enum("did_find_deconstruct", "did_not_find_deconstruct", [],  no_c_j_cs))).
:- type_representation(in_zone_deconstruct_map, is_eqv_to(map(prog_var, deconstruct_info))).
:- type_representation(one_arm_summary_map, is_eqv_to(map(prog_var, var_one_arm_summary))).
:- type_representation(process_unify(V_1, V_2), is_eqv_to(pred(prog_var, hlds_goal_expr, hlds_goal_info, list(hlds_goal), V_1, V_1, V_2, V_2))).
:- type_representation(switch_detect_info, is_word_aligned_ptr).
