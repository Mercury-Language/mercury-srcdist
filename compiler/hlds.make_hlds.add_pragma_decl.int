:- pred add_decl_pragmas_reuse(list.list(parse_tree.prog_item_pragma.decl_pragma_struct_reuse_info), hlds.hlds_module.module_info, hlds.hlds_module.module_info, list.list(parse_tree.error_spec.err_spec), list.list(parse_tree.error_spec.err_spec)).
