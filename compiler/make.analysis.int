:- module make.analysis.
:- interface.
:- use_module io.
:- use_module libs.
:- use_module list.
:- use_module mdbcomp.
:- use_module parse_tree.
:- use_module libs.globals.
:- use_module libs.maybe_util.
:- use_module make.make_info.
:- use_module mdbcomp.sym_name.
:- use_module parse_tree.error_spec.
:- type build2 == pred(io.text_output_stream, libs.maybe_util.maybe_succeeded, make.make_info.make_info, make.make_info.make_info, io.io, io.io).
:- type build3 == pred(io.text_output_stream, libs.maybe_util.maybe_succeeded, make.make_info.make_info, make.make_info.make_info, list.list(parse_tree.error_spec.diag_spec), list.list(parse_tree.error_spec.diag_spec), io.io, io.io).
:- inst build2 == (pred(builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det).
:- inst build3 == (pred(builtin.in, builtin.out, builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det).
:- pred build_analysis_files(libs.globals.globals, mdbcomp.sym_name.module_name, list.list(mdbcomp.sym_name.module_name), libs.maybe_util.maybe_succeeded, io.text_output_stream, libs.maybe_util.maybe_succeeded, make.make_info.make_info, make.make_info.make_info, io.io, io.io).
:- mode build_analysis_files(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred maybe_with_analysis_cache_dir_2(io.text_output_stream, libs.globals.globals, make.analysis.build2, libs.maybe_util.maybe_succeeded, make.make_info.make_info, make.make_info.make_info, io.io, io.io).
:- mode maybe_with_analysis_cache_dir_2(builtin.in, builtin.in, builtin.in((make.analysis).build2), builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
:- pred maybe_with_analysis_cache_dir_3(io.text_output_stream, libs.globals.globals, make.analysis.build3, libs.maybe_util.maybe_succeeded, make.make_info.make_info, make.make_info.make_info, list.list(parse_tree.error_spec.diag_spec), list.list(parse_tree.error_spec.diag_spec), io.io, io.io).
:- mode maybe_with_analysis_cache_dir_3(builtin.in, builtin.in, builtin.in((make.analysis).build3), builtin.out, builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det.
