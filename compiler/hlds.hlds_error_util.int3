:- module hlds.hlds_error_util.
:- interface.
:- type last_context_word
	where	type_is_abstract_enum(3).
:- type maybe_print_ho_var_name
	where	type_is_abstract_enum(1).
:- type should_module_qualify
	where	type_is_abstract_enum(1).
:- type_representation(last_context_word, du_repn(enum("lcw_none", "lcw_call", ["lcw_result", "lcw_argument", "lcw_element"],  no_c_j_cs))).
:- type_representation(maybe_print_ho_var_name, du_repn(enum("do_not_print_ho_var_name", "print_ho_var_name", [],  no_c_j_cs))).
:- type_representation(should_module_qualify, du_repn(enum("should_module_qualify", "should_not_module_qualify", [],  no_c_j_cs))).
