:- module ll_backend.stack_alloc.
:- interface.
:- use_module hlds.
:- use_module hlds.hlds_module.
:- use_module hlds.hlds_proc.
:- use_module hlds.pred_proc_id.
:- pred allocate_stack_slots_in_proc(hlds.hlds_module.module_info, hlds.pred_proc_id.pred_proc_id, hlds.hlds_proc.proc_info, hlds.hlds_proc.proc_info).
:- mode allocate_stack_slots_in_proc(builtin.in, builtin.in, builtin.in, builtin.out) is det.
