:- type ctor_defn
    --->    ctor_defn(
                 (hlds.type_util).ctor_tvars :: parse_tree.prog_data.tvarset,
                 (hlds.type_util).ctor_tvar_kinds :: parse_tree.prog_data.tvar_kind_map,
                 (hlds.type_util).ctor_maybe_exist :: parse_tree.prog_data.maybe_cons_exist_constraints,
                 (hlds.type_util).ctor_arg_types :: list.list(parse_tree.prog_data.mer_type),
                 (hlds.type_util).ctor_result_type :: parse_tree.prog_data.mer_type
            ).
:- type is_either_dummy_type
    --->    at_least_one_is_dummy_type 
    ;       neither_is_dummy_type .
