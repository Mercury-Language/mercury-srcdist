    ;       extra_goals(
                 (check_hlds.modecheck_util).extra_before_main :: list.list(hlds.hlds_goal.hlds_goal),
                 (check_hlds.modecheck_util).extra_after_main :: list.list(hlds.hlds_goal.hlds_goal)
            ).
