    ;       after_goals(
                 (check_hlds.modecheck_util).after_instmap :: hlds.instmap.instmap,
                 (check_hlds.modecheck_util).after_goals :: list.list(hlds.hlds_goal.hlds_goal)
            ).
:- type extra_goals
