:- module transform_hlds.unused_args.
:- interface.
:- import_module analysis.
:- import_module hlds.
:- import_module list.
:- import_module parse_tree.
:- import_module set.
:- import_module analysis.framework.
:- import_module hlds.hlds_module.
:- import_module parse_tree.error_spec.
:- import_module parse_tree.prog_item.
:- type maybe_gather_pragma_unused_args
	where	type_is_abstract_enum(1).
:- type maybe_record_analysis_unused_args
	where	type_is_abstract_enum(1).
:- type unused_args_answer.
:- type unused_args_call.
:- type unused_args_func_info.
:- instance analysis(transform_hlds.unused_args.unused_args_func_info, transform_hlds.unused_args.unused_args_call, transform_hlds.unused_args.unused_args_answer).
:- instance answer_pattern(transform_hlds.unused_args.unused_args_func_info, transform_hlds.unused_args.unused_args_answer).
:- instance call_pattern(transform_hlds.unused_args.unused_args_func_info, transform_hlds.unused_args.unused_args_call).
