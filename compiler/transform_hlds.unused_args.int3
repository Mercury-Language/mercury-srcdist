:- type_representation(local_var_usage_map, is_eqv_to(map(prog_var, usage_info))).
:- type_representation(maybe_gather_pragma_unused_args, du_repn(enum("do_not_gather_pragma_unused_args", "do_gather_pragma_unused_args", [],  no_c_j_cs))).
:- type_representation(maybe_record_analysis_unused_args, du_repn(enum("do_not_record_analysis_unused_args", "do_record_analysis_unused_args", [],  no_c_j_cs))).
:- type_representation(new_proc_map, is_eqv_to(map(pred_proc_id, new_proc_info))).
:- type_representation(unused_args_answer, du_repn(notag("unused_args_answer", list(int),  no_c_j_cs))).
:- type_representation(unused_args_call, du_repn(direct_dummy("unused_args_call",  no_c_j_cs))).
:- type_representation(unused_args_func_info, du_repn(notag("unused_args_func_info", pred_form_arity,  no_c_j_cs))).
