:- type type_ctor_repn_info.
:- type type_ctor_repn_map.
:- type_representation(abstract_solver_type_status, du_repn(enum("abstract_solver_type_exported", "abstract_solver_type_private", [],  no_c_j_cs))).
:- type_representation(c_j_cs_defns, is_eqv_to(parse_tree.prog_item_type.c_java_csharp(list(parse_tree.prog_item_type.item_type_defn_info_foreign)))).
:- type_representation(c_j_cs_enum_repn, is_eqv_to(parse_tree.prog_item_type.c_java_csharp(maybe(parse_tree.prog_item_type.enum_foreign_repn)))).
:- type_representation(c_j_cs_enums, is_eqv_to(parse_tree.prog_item_type.c_java_csharp(list(parse_tree.prog_item_type.item_foreign_enum_info)))).
:- type_representation(c_j_cs_maybe_defn, is_eqv_to(parse_tree.prog_item_type.c_java_csharp(maybe(parse_tree.prog_item_type.item_type_defn_info_foreign)))).
:- type_representation(c_j_cs_maybe_defn_or_enum, is_eqv_to(parse_tree.prog_item_type.c_java_csharp(maybe(parse_tree.prog_item_type.foreign_type_or_enum)))).
:- type_representation(c_j_cs_maybe_enum, is_eqv_to(parse_tree.prog_item_type.c_java_csharp(maybe(parse_tree.prog_item_type.item_foreign_enum_info)))).
:- type_representation(c_j_cs_repn, is_eqv_to(parse_tree.prog_item_type.c_java_csharp(maybe(parse_tree.prog_item_type.foreign_type_repn)))).
:- type_representation(cell_local_sectag, is_word_aligned_ptr).
:- type_representation(checked_foreign_enum, is_word_aligned_ptr).
:- type_representation(constant_repn, is_word_aligned_ptr).
:- type_representation(direct_dummy_repn, is_word_aligned_ptr).
