:- type_representation(foreign_type_lang_repn, is_word_aligned_ptr).
:- type_representation(foreign_type_repn, is_word_aligned_ptr).
:- type_representation(gen_du_more_functors_repn, is_word_aligned_ptr).
:- type_representation(gen_du_only_functor_repn, is_word_aligned_ptr).
:- type_representation(inst_ctor_all_defns, is_word_aligned_ptr).
:- type_representation(inst_ctor_defn_map, is_eqv_to(map(inst_ctor, parse_tree.prog_item_type.inst_ctor_all_defns))).
:- type_representation(item_foreign_enum_info, is_word_aligned_ptr).
:- type_representation(item_type_defn_info, is_eqv_to(parse_tree.prog_item_type.item_type_defn_info_general(type_defn))).
:- type_representation(item_type_defn_info_abstract, is_eqv_to(parse_tree.prog_item_type.item_type_defn_info_general(type_details_abstract))).
:- type_representation(item_type_defn_info_du, is_eqv_to(parse_tree.prog_item_type.item_type_defn_info_general(type_details_du))).
:- type_representation(item_type_defn_info_eqv, is_eqv_to(parse_tree.prog_item_type.item_type_defn_info_general(type_details_eqv))).
:- type_representation(item_type_defn_info_foreign, is_eqv_to(parse_tree.prog_item_type.item_type_defn_info_general(type_details_foreign_generic))).
:- type_representation(item_type_defn_info_solver, is_eqv_to(parse_tree.prog_item_type.item_type_defn_info_general(type_details_solver))).
:- type_representation(item_type_defn_info_sub, is_eqv_to(parse_tree.prog_item_type.item_type_defn_info_general(type_details_sub))).
:- type_representation(item_type_repn_info, is_eqv_to(parse_tree.prog_item_type.item_type_repn_info_general(parse_tree.prog_item_type.type_ctor_repn_info))).
:- type_representation(item_type_repn_info_eqv, is_eqv_to(parse_tree.prog_item_type.item_type_repn_info_general(mer_type))).
:- type_representation(item_type_repn_info_subtype, is_eqv_to(parse_tree.prog_item_type.item_type_repn_info_general(type_ctor))).
:- type_representation(mode_ctor_all_defns, is_word_aligned_ptr).
:- type_representation(mode_ctor_defn_map, is_eqv_to(map(mode_ctor, parse_tree.prog_item_type.mode_ctor_all_defns))).
:- type_representation(more_nonconstant_local_cell_repn, is_word_aligned_ptr).
:- type_representation(more_nonconstant_remote_cell_repn, is_word_aligned_ptr).
:- type_representation(notag_repn, is_word_aligned_ptr).
:- type_representation(only_nonconstant_local_cell_repn, du_repn(notag("only_nonconstant_local_cell_repn", one_or_more(local_arg_repn),  no_c_j_cs))).
:- type_representation(only_nonconstant_remote_cell_repn, du_repn(notag("only_nonconstant_remote_cell_repn", one_or_more(remote_arg_repn),  no_c_j_cs))).
:- type_representation(src_defns_solver, is_word_aligned_ptr).
:- type_representation(src_defns_std, is_word_aligned_ptr).
:- type_representation(std_abs_type_status, du_repn(enum("std_abs_type_ft_exported", "std_abs_type_abstract_exported", ["std_abs_type_all_private"],  no_c_j_cs))).
:- type_representation(std_du_type_status, du_repn(enum("std_du_type_mer_ft_exported", "std_du_type_mer_exported", ["std_du_type_abstract_exported", "std_du_type_all_private"],  no_c_j_cs))).
:- type_representation(std_eqv_type_status, du_repn(enum("std_eqv_type_mer_exported", "std_eqv_type_abstract_exported", ["std_eqv_type_all_private"],  no_c_j_cs))).
:- type_representation(std_subtype_status, du_repn(enum("std_sub_type_mer_exported", "std_sub_type_abstract_exported", ["std_sub_type_all_private"],  no_c_j_cs))).
:- type_representation(type_ctor_all_defns, is_word_aligned_ptr).
:- type_representation(type_ctor_checked_map, is_eqv_to(map(type_ctor, parse_tree.prog_item_type.type_ctor_checked_defn))).
:- type_representation(type_ctor_defn_map, is_eqv_to(map(type_ctor, parse_tree.prog_item_type.type_ctor_all_defns))).
:- type_representation(type_ctor_foreign_enum_map, is_eqv_to(map(type_ctor, parse_tree.prog_item_type.c_j_cs_enums))).
:- type_representation(type_ctor_maybe_defn, is_word_aligned_ptr).
:- type_representation(type_ctor_repn_map, is_eqv_to(map(type_ctor, parse_tree.prog_item_type.item_type_repn_info))).
