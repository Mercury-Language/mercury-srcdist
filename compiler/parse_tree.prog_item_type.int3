:- module parse_tree.prog_item_type.
:- interface.
:- type abstract_solver_type_status
	where	type_is_abstract_enum(1).
:- type c_j_cs_defns.
:- type c_j_cs_enum_repn.
:- type c_j_cs_enums.
:- type c_j_cs_maybe_defn.
:- type c_j_cs_maybe_defn_or_enum.
