:- type src_defns_std.
:- type std_abs_type_status
	where	type_is_abstract_enum(2).
:- type std_du_type_status
	where	type_is_abstract_enum(2).
:- type std_eqv_type_status
	where	type_is_abstract_enum(2).
:- type std_subtype_status
	where	type_is_abstract_enum(2).
