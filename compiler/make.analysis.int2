:- module make.analysis.
:- interface.
:- use_module io.
:- use_module list.
:- use_module libs.maybe_util.
:- use_module make.make_info.
:- use_module parse_tree.error_spec.
:- type build2 == pred(io.text_output_stream, libs.maybe_util.maybe_succeeded, make.make_info.make_info, make.make_info.make_info, io.io, io.io).
:- type build3 == pred(io.text_output_stream, libs.maybe_util.maybe_succeeded, make.make_info.make_info, make.make_info.make_info, list.list(parse_tree.error_spec.error_spec), list.list(parse_tree.error_spec.error_spec), io.io, io.io).
:- inst build2 == (pred(builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det).
:- inst build3 == (pred(builtin.in, builtin.out, builtin.in, builtin.out, builtin.in, builtin.out, builtin.di, builtin.uo) is det).
