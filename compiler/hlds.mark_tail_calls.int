:- module hlds.mark_tail_calls.
:- interface.
:- use_module libs.
:- use_module list.
:- use_module parse_tree.
:- use_module set.
:- use_module set_tree234.
:- use_module hlds.hlds_dependency_graph.
:- use_module hlds.hlds_markers.
:- use_module hlds.hlds_module.
:- use_module hlds.hlds_pred.
:- use_module libs.compiler_util.
:- use_module libs.dependency_graph.
:- use_module libs.globals.
:- use_module parse_tree.error_spec.
:- use_module parse_tree.prog_data.
:- use_module parse_tree.prog_data_pragma.
:- type later_op.
:- type maybe_warn_non_tail_mutual_rec
    --->    do_not_warn_non_tail_mutual_rec 
    ;       warn_non_tail_mutual_rec .
:- type maybe_warn_non_tail_self_rec
    --->    do_not_warn_non_tail_self_rec 
    ;       warn_non_tail_self_rec .
:- type nontail_rec_call_reason
    --->    ntrcr_program(
                 set_tree234.set_tree234(hlds.mark_tail_calls.later_op)
            )
    ;       ntrcr_mlds_in_scc_not_in_tscc 
    ;       ntrcr_mlds_in_tscc_stack_ref 
    ;       ntrcr_mlds_model_non_in_cont_func .
:- type nontail_rec_obviousness
    --->    non_obvious_nontail_rec 
    ;       obvious_nontail_rec .
:- type report_requested_by
    --->    request_by_code 
    ;       request_by_option .
:- type warn_non_tail_rec_params
    --->    warn_non_tail_rec_params(
                 hlds.mark_tail_calls.report_requested_by,
                 libs.compiler_util.warning_or_error,
                 parse_tree.prog_data_pragma.report_in_which_grades,
                 hlds.mark_tail_calls.maybe_warn_non_tail_self_rec,
                 hlds.mark_tail_calls.maybe_warn_non_tail_mutual_rec
            ).
:- pred get_default_warn_parms(libs.globals.globals, hlds.mark_tail_calls.warn_non_tail_rec_params).
:- mode get_default_warn_parms(builtin.in, builtin.out) is det.
:- pred mark_self_and_mutual_tail_rec_calls_in_module_for_mlds_code_gen(hlds.hlds_dependency_graph.hlds_dependency_info, hlds.hlds_module.module_info, hlds.hlds_module.module_info, list.list(parse_tree.error_spec.error_spec), list.list(parse_tree.error_spec.error_spec)).
:- mode mark_self_and_mutual_tail_rec_calls_in_module_for_mlds_code_gen(builtin.in, builtin.in, builtin.out, builtin.in, builtin.out) is det.
:- pred mark_tail_rec_calls_in_pred_for_llds_code_gen(libs.dependency_graph.scc_map(hlds.hlds_pred.pred_proc_id), hlds.hlds_pred.pred_id, hlds.hlds_module.module_info, hlds.hlds_module.module_info, hlds.hlds_pred.pred_info, hlds.hlds_pred.pred_info, list.list(parse_tree.error_spec.error_spec), list.list(parse_tree.error_spec.error_spec)).
:- mode mark_tail_rec_calls_in_pred_for_llds_code_gen(builtin.in, builtin.in, builtin.in, builtin.out, builtin.in, builtin.out, builtin.in, builtin.out) is det.
:- pred mark_tail_rec_calls_in_proc_for_llds_code_gen(hlds.hlds_module.module_info, hlds.hlds_pred.pred_id, hlds.hlds_pred.proc_id, hlds.hlds_pred.pred_info, libs.dependency_graph.scc_map(hlds.hlds_pred.pred_proc_id), hlds.hlds_pred.proc_info, hlds.hlds_pred.proc_info, list.list(parse_tree.error_spec.error_spec), list.list(parse_tree.error_spec.error_spec)).
:- mode mark_tail_rec_calls_in_proc_for_llds_code_gen(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out, builtin.in, builtin.out) is det.
:- pred maybe_override_warn_params_for_proc(hlds.hlds_pred.proc_info, hlds.mark_tail_calls.warn_non_tail_rec_params, hlds.mark_tail_calls.warn_non_tail_rec_params).
:- mode maybe_override_warn_params_for_proc(builtin.in, builtin.in, builtin.out) is det.
:- pred maybe_report_nontail_recursive_call(hlds.hlds_module.module_info, hlds.mark_tail_calls.warn_non_tail_rec_params, hlds.hlds_pred.pred_proc_id, hlds.hlds_pred.pred_proc_id, set.set(hlds.hlds_markers.goal_feature), parse_tree.prog_data.prog_context, hlds.mark_tail_calls.nontail_rec_call_reason, hlds.mark_tail_calls.nontail_rec_obviousness, list.list(parse_tree.error_spec.error_spec), list.list(parse_tree.error_spec.error_spec)).
:- mode maybe_report_nontail_recursive_call(builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.in, builtin.out) is det.
:- implementation.
:- type later_op
	where	type_is_abstract_enum(4).
