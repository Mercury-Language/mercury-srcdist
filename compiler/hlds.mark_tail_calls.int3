:- module hlds.mark_tail_calls.
:- interface.
:- type later_op.
:- type maybe_warn_non_tail_mutual_rec
	where	type_is_abstract_enum(1).
:- type maybe_warn_non_tail_self_rec
	where	type_is_abstract_enum(1).
:- type nontail_rec_call_reason.
:- type nontail_rec_obviousness
	where	type_is_abstract_enum(1).
:- type report_requested_by
	where	type_is_abstract_enum(1).
:- type warn_non_tail_rec_params.
:- type_representation(later_op, du_repn(enum("later_unify", "later_unify_assign", ["later_nonrec_call", "later_rec_call", "later_par_join", "later_disjunction", "later_disjunction_fail", "later_switch", "later_ite", "later_negation", "later_next_disjunct", "later_cond_end", "later_negation_end", "later_commit", "later_trail_prune"],  no_c_j_cs))).
:- type_representation(maybe_warn_non_tail_mutual_rec, du_repn(enum("do_not_warn_non_tail_mutual_rec", "warn_non_tail_mutual_rec", [],  no_c_j_cs))).
:- type_representation(maybe_warn_non_tail_self_rec, du_repn(enum("do_not_warn_non_tail_self_rec", "warn_non_tail_self_rec", [],  no_c_j_cs))).
:- type_representation(nontail_rec_obviousness, du_repn(enum("non_obvious_nontail_rec", "obvious_nontail_rec", [],  no_c_j_cs))).
:- type_representation(report_requested_by, du_repn(enum("request_by_code", "request_by_option", [],  no_c_j_cs))).
:- type_representation(warn_non_tail_rec_params, is_word_aligned_ptr).
